<Window x:Class="SportHubBase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Турниры — SportHub"
        Width="1180" MinWidth="960"
        Height="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA" FontFamily="Segoe UI" UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Хедер -->
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Фильтры -->
            <RowDefinition Height="*"/>
            <!-- Список -->
            <RowDefinition Height="Auto"/>
            <!-- Футер -->
        </Grid.RowDefinitions>

        <!-- Служебные действия отделены от работы с турнирами. -->
        <StackPanel Grid.Row="0">
        <Border Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1" Padding="28,12">
            <DockPanel>
                <Menu DockPanel.Dock="Right" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Background="Transparent" FontSize="14">
                    <MenuItem Header="_Настройки" Padding="12,8">
                        <MenuItem Header="Резервные копии локальной базы">
                            <MenuItem Header="Сохранить резервную копию…" Click="CreateBackup_Click"/>
                            <MenuItem Header="Восстановить из копии…" Click="RestoreBackup_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Проверить обновления" Click="CheckUpdatesButton_Click"/>
                    </MenuItem>
                </Menu>
                <TextBlock Text="SportHub" FontSize="20" FontWeight="Bold"
                           Foreground="#1E293B" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border Margin="28,20,28,0" Height="260" CornerRadius="20">
            <Border.Background>
                <ImageBrush ImageSource="/Image/SportStadionUltraWitheMainLogo.jpeg"
                            Stretch="UniformToFill"/>
            </Border.Background>
            <Border Background="#80000000" CornerRadius="20"/>
        </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,24,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Турниры" FontSize="28" FontWeight="SemiBold" Foreground="#1E293B"/>
                <TextBlock Text="Выберите турнир, чтобы продолжить работу"
                           Margin="0,4,0,0" FontSize="13" Foreground="#64748B"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ConnectRemoteButton" Content="Добавить с сервера"
                        Style="{StaticResource DefaultModernButton}"
                        Margin="0,0,12,0" Padding="16,10" Click="ConnectRemoteButton_Click"/>
                <Button x:Name="AddTurnament" Content="Создать турнир"
                        Style="{StaticResource ModernAddButton}" Padding="20,10"
                        Click="AddTurnament_Click"/>
            </StackPanel>
        </Grid>
        <!-- 3. Панель фильтров -->
        <Border Grid.Row="2"
                Background="White"
                Padding="28,16"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Style="{StaticResource ModernSearchBox}"
                         Text="" ToolTip="Поиск по названию, городу или организатору" AutomationProperties.Name="Поиск турниров"
                         TextChanged="SearchTextBox_TextChanged"/>

                <ComboBox x:Name="SportFilterComboBox"
                          Grid.Column="1"
                          Margin="16,0,0,0"
                          Style="{StaticResource ModernComboBox}"
                          SelectedIndex="0"
                          SelectionChanged="SportFilterComboBox_SelectionChanged">
                    <ComboBoxItem>Любой спорт</ComboBoxItem>
                    <ComboBoxItem>Волейбол</ComboBoxItem>
                    <ComboBoxItem>Футбол</ComboBoxItem>
                    <ComboBoxItem>Баскетбол</ComboBoxItem>
                    <ComboBoxItem>Другое</ComboBoxItem>
                </ComboBox>

                <ComboBox x:Name="StorageFilterComboBox"
                          Grid.Column="2"
                          Margin="16,0,0,0"
                          Style="{StaticResource ModernComboBox}"
                          SelectedIndex="0"
                          SelectionChanged="SportFilterComboBox_SelectionChanged">
                    <ComboBoxItem>Все турниры</ComboBoxItem>
                    <ComboBoxItem>Локальные</ComboBoxItem>
                    <ComboBoxItem>Удалённые (Сервер)</ComboBoxItem>
                </ComboBox>

                <Button Grid.Column="3" Margin="16,0,0,0"
                        Content="Обновить список"
                        Style="{StaticResource DefaultModernButton}"
                        Padding="16,8"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <!-- 4. Список турниров -->
        <ScrollViewer Grid.Row="3"
                      Margin="28,16,28,12"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TournamentsPanel" ItemsSource="{Binding Tournaments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="12"
                                Margin="0,0,0,16"
                                Padding="20,16"
                                Cursor="Hand"
                                MouseLeftButtonUp="TournamentItem_MouseLeftButtonUp"
                                Tag="{Binding Id}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Вид спорта -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SportType}"
                                           Foreground="#64748B"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>

                                <!-- Название турнира -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B"
                                           Margin="16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                           VerticalAlignment="Center"/>

                                <!-- Бейдж режима хранения (Локальный / Сервер / Оффлайн-кэш) -->
                                <Border Grid.Column="2"
                                        Background="{Binding StorageBadgeBackground}"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StorageBadgeText}"
                                               Foreground="{Binding StorageBadgeForeground}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <!-- Организатор -->
                                <TextBlock Grid.Column="3"
                                           MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip="{Binding OwnerName}" Text="{Binding OwnerName, StringFormat='Организатор: {0}', TargetNullValue='Организатор: Локальный'}"
                                           Foreground="#64748B"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="28,16,28,12" Background="White" CornerRadius="12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tournaments.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <TextBlock Text="Нет турниров для отображения" FontSize="20" FontWeight="SemiBold"
                           Foreground="#334155" TextAlignment="Center"/>
                <TextBlock Text="Создайте турнир, добавьте его с сервера или измените условия поиска."
                           Margin="0,8,0,0" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="28,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtAppVersion" DockPanel.Dock="Right"
                           Text="SportHub" Foreground="#64748B"/>
                <TextBlock Text="{Binding Tournaments.Count, StringFormat='Показано турниров: {0}'}"
                           Foreground="#64748B"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
