<Window x:Class="SportHubBase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Турниры — SportHub"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Хедер -->
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Фильтры -->
            <RowDefinition Height="*"/>
            <!-- Список -->
            <RowDefinition Height="Auto"/>
            <!-- Футер -->
        </Grid.RowDefinitions>

        <!-- 1. Хедер с фото -->
        <Border Grid.Row="0"
                Margin="40,20,40,40"
                Height="260"
                CornerRadius="20">
            <Border.Background>
                <ImageBrush ImageSource="/Image/SportStadionUltraWitheMainLogo.jpeg"
                            Stretch="UniformToFill"/>
            </Border.Background>
            <Border Background="#80000000" CornerRadius="20"/>
        </Border>

        <!-- 2. Заголовок + кнопки -->
        <Grid Grid.Row="1" Margin="40,0,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Турниры"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="#2D3748"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CheckUpdatesButton"
                        Style="{StaticResource DefaultModernButton}"
                        Content="🔄 Обновления"
                        Margin="0,0,12,0"
                        Padding="16,10"
                        Click="CheckUpdatesButton_Click"/>

                <Button x:Name="ConnectRemoteButton"
                        Style="{StaticResource DefaultModernButton}"
                        Content="🌐 Подключить с сервера"
                        Margin="0,0,12,0"
                        Padding="20,10"
                        Click="ConnectRemoteButton_Click"/>

                <Button x:Name="AddTurnament"
                        Style="{StaticResource ModernAddButton}"
                        Content="Добавить"
                        Click="AddTurnament_Click"/>
            </StackPanel>
        </Grid>

        <!-- 3. Панель фильтров -->
        <Border Grid.Row="2"
                Background="White"
                Padding="40,20"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Style="{StaticResource ModernSearchBox}"
                         Text=""
                         TextChanged="SearchTextBox_TextChanged"/>

                <ComboBox x:Name="SportFilterComboBox"
                          Grid.Column="1"
                          Margin="16,0,0,0"
                          Style="{StaticResource ModernComboBox}"
                          SelectedIndex="0"
                          SelectionChanged="SportFilterComboBox_SelectionChanged">
                    <ComboBoxItem>Любой спорт</ComboBoxItem>
                    <ComboBoxItem>Волейбол</ComboBoxItem>
                    <ComboBoxItem>Футбол</ComboBoxItem>
                    <ComboBoxItem>Баскетбол</ComboBoxItem>
                    <ComboBoxItem>Другое</ComboBoxItem>
                </ComboBox>

                <ComboBox x:Name="StorageFilterComboBox"
                          Grid.Column="2"
                          Margin="16,0,0,0"
                          Style="{StaticResource ModernComboBox}"
                          SelectedIndex="0"
                          SelectionChanged="SportFilterComboBox_SelectionChanged">
                    <ComboBoxItem>Все турниры</ComboBoxItem>
                    <ComboBoxItem>Локальные</ComboBoxItem>
                    <ComboBoxItem>Удалённые (Сервер)</ComboBoxItem>
                </ComboBox>

                <Button Grid.Column="4"
                        Content="🔄 Обновить"
                        Style="{StaticResource DefaultModernButton}"
                        Padding="16,8"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <!-- 4. Список турниров -->
        <ScrollViewer Grid.Row="3"
                      Margin="40,24,40,20"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TournamentsPanel" ItemsSource="{Binding Tournaments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="12"
                                Margin="0,0,0,16"
                                Padding="24"
                                Cursor="Hand"
                                MouseLeftButtonUp="TournamentItem_MouseLeftButtonUp"
                                Tag="{Binding Id}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Вид спорта -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SportType}"
                                           Foreground="#64748B"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>

                                <!-- Название турнира -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B"
                                           Margin="16,0"
                                           VerticalAlignment="Center"/>

                                <!-- Бейдж режима хранения (Локальный / Сервер / Оффлайн-кэш) -->
                                <Border Grid.Column="2"
                                        Background="{Binding StorageBadgeBackground}"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StorageBadgeText}"
                                               Foreground="{Binding StorageBadgeForeground}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <!-- Организатор -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding OwnerName, StringFormat='Организатор: {0}', TargetNullValue='Организатор: Локальный'}"
                                           Foreground="#64748B"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 5. Футер -->
        <Border Grid.Row="4"
                Background="White"
                Padding="40,20"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtAppVersion" Text="SportHub" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="support@test.ru" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>