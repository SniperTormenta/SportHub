<Window x:Class="SportHubBase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Турниры"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Хедер -->
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Фильтры -->
            <RowDefinition Height="*"/>
            <!-- Список -->
            <RowDefinition Height="Auto"/>
            <!-- Футер -->
        </Grid.RowDefinitions>

        <!-- 1. Хедер с фото — теперь выглядит идеально -->
        <Border Grid.Row="0"
                Margin="40,20,40,40"
                Height="260"
                CornerRadius="20">
            <Border.Background>
                <ImageBrush ImageSource="/Image/SportStadionUltraWitheMainLogo.jpeg"
                            Stretch="UniformToFill"/>
            </Border.Background>
            <Border Background="#80000000" CornerRadius="20"/>
        </Border>

        <!-- 2. Заголовок + кнопка "Добавить" -->
        <Grid Grid.Row="1" Margin="40,0,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Турниры"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="#2D3748"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    x:Name="AddTurnament"
                    Style="{StaticResource ModernAddButton}"
                    Content="Добавить"
                    Click="AddTurnament_Click"/>
        </Grid>

        <!-- 3. Панель фильтров  -->
        <Border Grid.Row="2"
                Background="White"
                Padding="40,20"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <TextBox Grid.Column="0"
         Style="{StaticResource ModernSearchBox}"
         Text=" " />

                    <ComboBox Grid.Column="1"
                          Margin="16,0,0,0"
                          Style="{StaticResource ModernComboBox}"
                          SelectedIndex="0">
                         <ComboBoxItem>Любой спорт</ComboBoxItem>
                         <ComboBoxItem>Футбол</ComboBoxItem>
                         <ComboBoxItem>Баскетбол</ComboBoxItem>
                         <ComboBoxItem>Волейбол</ComboBoxItem>
                         <ComboBoxItem>Теннис</ComboBoxItem>
                </ComboBox>

                <!-- Переключатель вида (список / карточки) -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Список (по умолчанию включён) -->
                    <RadioButton x:Name="ListViewRadio"
                                 GroupName="ViewMode"
                                 IsChecked="True">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        BorderBrush="#CBD5E0"
                                        BorderThickness="1.5"
                                        CornerRadius="8">
                                    <Path Data="M3,6 H21 V8 H3 V6 Z M3,11 H21 V13 H3 V11 Z M3,16 H21 V18 H3 V16 Z"
                                          Fill="#64748B"
                                          Stretch="Uniform"
                                          Width="18"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E0F2FE"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- Карточки -->
                    <RadioButton x:Name="GridViewRadio"
                                 GroupName="ViewMode"
                                 Margin="8,0,0,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        BorderBrush="#CBD5E0"
                                        BorderThickness="1.5"
                                        CornerRadius="8">
                                    <Path Data="M4,4 H10 V10 H4 V4 Z M14,4 H20 V10 H14 V4 Z M4,14 H10 V20 H4 V14 Z M14,14 H20 V20 H14 V14 Z"
                                          Fill="#64748B"
                                          Stretch="Uniform"
                                          Width="18"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E0F2FE"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Список турниров -->
        <ScrollViewer Grid.Row="3"
              Margin="40,24,40,20"
              VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TournamentsPanel" ItemsSource="{Binding Tournaments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                        CornerRadius="12"
                        Margin="0,0,0,16"
                        Padding="24"
                        Cursor="Hand"
                        MouseLeftButtonUp="TournamentItem_MouseLeftButtonUp"
                        Tag="{Binding Id}">
                            <!-- Передаём ID для открытия -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Вид спорта -->
                                <TextBlock Grid.Column="0"
                                   Text="{Binding SportType}"
                                   Foreground="#64748B"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>

                                <!-- Название турнира -->
                                <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="16,0"
                                   VerticalAlignment="Center"/>

                                <!-- Организатор -->
                                <TextBlock Grid.Column="2"
                                   Text="Организатор: Фарватер"
                                   Foreground="#64748B"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 5. Футер -->
        <Border Grid.Row="4"
                Background="White"
                Padding="40,20"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="test.ru" Foreground="#94A3B8"/>
                <TextBlock Grid.Column="1" Text="support@test.ru" Foreground="#94A3B8"/>
            </Grid>
        </Border>
    </Grid>
</Window>