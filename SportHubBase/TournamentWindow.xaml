<Window x:Class="SportHubBase.TournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding CurrentTournament.Name}"
        Height="950" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F8"
        FontFamily="Inter, Segoe UI">

    <Grid>
        <!-- Header -->
        <Border Background="White" Height="80" VerticalAlignment="Top">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#137FEC" Margin="0,0,12,0">
                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CyberTournaments" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Share" Background="#137FEC" Foreground="White" FontWeight="Bold" Padding="16,10" Margin="0,0,12,0"/>
                    <Button Content="Edit Tournament" Background="#F0F2F4" Foreground="#111418" FontWeight="Bold" Padding="16,10" Margin="0,0,12,0"/>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#137FEC">
                        <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Название турнира -->
        <StackPanel Margin="40,100,40,0">
            <TextBlock Text="{Binding CurrentTournament.Name}"
                       FontSize="36" FontWeight="Black" Foreground="#111418"/>
        </StackPanel>

        <!-- TabControl -->
        <TabControl Style="{StaticResource TailwindTabControl}"
                    Margin="0,200,0,0"
                    SelectedIndex="0">

            <TabItem Header="Главная" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Команды -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Teams}" AlternationCount="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Command="{Binding DataContext.EditTeamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Margin="8" Padding="12" CornerRadius="8"
                                                    Background="#F9FAFB">
                                                <StackPanel>
                                                    <Border Width="80" Height="80" CornerRadius="40" Margin="0,0,0,12" Background="#F0F2F4">
                                                        <TextBlock Text="T" Foreground="#617589" FontSize="24" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextAlignment="Center" Foreground="#111418"/>
                                                    <TextBlock Text="{Binding Captain}" FontSize="13" Foreground="#617589" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Сайдбар на русском -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" Margin="24,0,0,0">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Количество команд" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="{Binding TeamsCount}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Формат" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="{Binding FormatText}" FontSize="18" FontWeight="Bold" Foreground="#111418"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="Даты проведения" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="{Binding DatesText}" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#111418"
                                           TextWrapping="Wrap"/>
                                <!-- Важно: Wrap, чтобы переносился на новую строку -->
                            </StackPanel>

                            <Button Command="{Binding AddTeamCommand}"
                                    Background="#137FEC20" Foreground="#137FEC" FontWeight="Bold" Padding="20,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Добавить команду"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка расписания -->
            <TabItem Header="Расписание" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Сообщение (для заглушек и ошибок) -->
                    <TextBlock Text="{Binding ScheduleMessage}"
                               FontSize="16"
                               Foreground="#617589"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"/>

                    <!-- Простое отображение туров и матчей -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Schedule}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" Background="White" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Round, StringFormat='Тур {0}'}"
                                                       Width="100"
                                                       FontWeight="Bold"
                                                       Foreground="#111418"/>
                                            <TextBlock Text="{Binding Team1}"
                                                       Margin="8,0,4,0"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="vs"
                                                       Margin="0,0,4,0"
                                                       Foreground="#617589"/>
                                            <TextBlock Text="{Binding Team2}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Результаты" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Сообщение (для заглушек и ошибок) -->
                    <TextBlock Text="{Binding ResultsMessage}"
                               FontSize="16"
                               Foreground="#617589"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"/>

                    <!-- Шахматная таблица результатов для кругового турнира -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <!-- Левая колонка (индекс + название команды) -->
                                <ColumnDefinition Width="220"/>
                                <!-- Правая часть с динамическими столбцами -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Заголовок: пустая ячейка слева + номера столбцов -->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="#" FontWeight="Bold" Margin="4" />
                            </Grid>
                            <ScrollViewer Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ResultsHeaderNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="40" Padding="4" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,2,0">
                                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Левая часть с командами -->
                            <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding ResultsTable}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,1,1" Padding="4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Index}" Width="24" FontWeight="Bold" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding TeamName}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Правая часть с ячейками результатов -->
                            <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{Binding ResultsTable}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="40" Height="28" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,2,2" Background="White">
                                                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Настройки" Style="{StaticResource TailwindTabItem}">
                <TextBlock Text="Настройки — в разработке" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>