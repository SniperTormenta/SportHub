
    <Window x:Class="SportHubBase.TournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SportHubBase.Converters;assembly=SportHubBase"
        Title="{Binding CurrentTournament.Name}"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="#F6F7F8"
        FontFamily="Inter, Segoe UI"
        MinWidth="1200"
        MinHeight="800">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ResultTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Header -->
        <Border Background="White" Height="80" VerticalAlignment="Top">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#137FEC" Margin="0,0,12,0">
                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                </StackPanel>
            </Grid>
        </Border>

        <!-- РќР°Р·РІР°РЅРёРµ С‚СѓСЂРЅРёСЂР° -->
        <StackPanel Margin="40,100,40,0">
            <TextBlock Text="{Binding CurrentTournament.Name}"
                       FontSize="36" FontWeight="Black" Foreground="#111418"/>
        </StackPanel>

        <!-- TabControl -->
        <TabControl Style="{StaticResource TailwindTabControl}"
                    Margin="0,200,0,0"
                    SelectedIndex="0"
                    SelectionChanged="TabControl_SelectionChanged">

            <TabItem Header="Р“Р»Р°РІРЅР°СЏ" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- РљР°СЂС‚РѕС‡РєРё РєРѕРјР°РЅРґ -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Teams}" AlternationCount="2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6"
                                        Padding="10"
                                        CornerRadius="8"
                                        Background="#F9FAFB"
                                        Cursor="Hand"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.EditTeamCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      CommandParameter="{Binding}"/>
                                                </Border.InputBindings>

                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F9FAFB"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="Effect" Value="{x:Null}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel>
                                                    <Border Width="72" Height="72"
                                                CornerRadius="36"
                                                Margin="0,0,0,10"
                                                Background="#F0F2F4"
                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="T"
                                                       Foreground="#617589"
                                                       FontSize="30"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding Name}"
                                                   FontWeight="Medium"
                                                   FontSize="13"
                                                   TextAlignment="Center"
                                                   Foreground="#111418"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,3"/>

                                                    <TextBlock Text="{Binding Captain}"
                                                   FontSize="12"
                                                   Foreground="#617589"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- РЎР°Р№РґР±Р°СЂ СЃРїСЂР°РІР° -->
                        <ScrollViewer Grid.Column="1">
                            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" Margin="24,0,0,0">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="РЎС‚Р°С‚СѓСЃ" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding TournamentStatusText}" FontSize="20" FontWeight="Bold" Foreground="#137FEC"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="РљРѕР»РёС‡РµСЃС‚РІРѕ РєРѕРјР°РЅРґ" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding TeamsCount}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="РЎС‹РіСЂР°РЅРѕ РјР°С‚С‡РµР№" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding MatchesProgressText}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="Р›РёРґРµСЂ С‚СѓСЂРЅРёСЂР°" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding LeaderText}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="Р¤РѕСЂРјР°С‚" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding FormatText}" FontSize="18" FontWeight="Bold" Foreground="#111418"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,40">
                                    <TextBlock Text="Р”Р°С‚С‹ РїСЂРѕРІРµРґРµРЅРёСЏ" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding DatesText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111418"
                                   TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Command="{Binding AddTeamCommand}"
                            Style="{StaticResource AddTeamButtonStyle}"
                            Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Р”РѕР±Р°РІРёС‚СЊ РєРѕРјР°РЅРґСѓ"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding FinishTournamentCommand}"
                            Style="{StaticResource AddTeamButtonStyle}"
                            Background="#FFF1F2"
                            Foreground="#E11D48"
                            BorderBrush="#FECDD3"
                            BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="рџЏЃ" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Р—Р°РІРµСЂС€РёС‚СЊ С‚СѓСЂРЅРёСЂ"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- РќРёР¶РЅРёРµ РєРЅРѕРїРєРё РёРјРїРѕСЂС‚Р°/СЌРєСЃРїРѕСЂС‚Р° -->
                    <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                        <Button Command="{Binding ImportTeamsExcelCommand}"
                    Style="{StaticResource AddTeamButtonStyle}"
                    Margin="0,0,12,0"
                    Background="#F3F4F6"
                    Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="рџ“Ґ" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="РРјРїРѕСЂС‚ РєРѕРјР°РЅРґ (Excel)"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportTeamsExcelCommand}"
                    Style="{StaticResource AddTeamButtonStyle}"
                    Margin="0,0,12,0"
                    Background="#F3F4F6"
                    Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="рџ“¤" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Р­РєСЃРїРѕСЂС‚ РєРѕРјР°РЅРґ (Excel)"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DownloadTemplateCommand}"
                    Style="{StaticResource AddTeamButtonStyle}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                            <TextBlock Text="РЎРєР°С‡Р°С‚СЊ С€Р°Р±Р»РѕРЅ РґР»СЏ РёРјРїРѕСЂС‚Р°"
                           FontSize="13"
                           Foreground="#137FEC"
                           TextDecorations="Underline"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Р’РєР»Р°РґРєР° СЂР°СЃРїРёСЃР°РЅРёСЏ -->
            <TabItem Header="Р Р°СЃРїРёСЃР°РЅРёРµ" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Main Content -->
                    <Grid Grid.Column="0" Margin="0,0,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Controls: Search & Filter -->
                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Height="48" Margin="0,0,16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="рџ”Ќ" Margin="12,0,8,0" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                                    <TextBox Text="{Binding ScheduleVM.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                             FontSize="14" Grid.Column="1"
                                             Tag="РџРѕРёСЃРє..."/>
                                </Grid>
                            </Border>

                            <!-- Refresh Button -->
                            <Button Grid.Column="1" Content="в†є" 
                                    Command="{Binding ScheduleVM.RefreshCommand}"
                                    Style="{StaticResource DefaultModernButton}"
                                    Padding="12,0" Height="48" Margin="0,0,16,0"
                                    ToolTip="РћР±РЅРѕРІРёС‚СЊ СЂР°СЃРїРёСЃР°РЅРёРµ"/>

                            <!-- Filter -->
                            <ComboBox Grid.Column="2" 
                                      ItemsSource="{Binding ScheduleVM.FilterOptions}"
                                      SelectedItem="{Binding ScheduleVM.Filter}"
                                      Height="48" MinWidth="150"
                                      Style="{StaticResource ModernComboBox}"/>
                        </Grid>

                        <!-- Message -->
                        <TextBlock Grid.Row="1" Text="{Binding ScheduleVM.ScheduleMessage}"
                                   FontSize="16" Foreground="#617589" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- Matches List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScheduleVM.FilteredMatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Padding="16" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="2" Duration="0:0:0.2"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#137FEC" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="1" Duration="0:0:0.2"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E5E7EB" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/> <!-- Number -->
                                                    <ColumnDefinition Width="100"/> <!-- Status -->
                                                    <ColumnDefinition Width="*"/>    <!-- Teams -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Button -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Number -->
                                                <Border Grid.Column="0" Background="#F3F4F6" CornerRadius="6" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MatchNumber, TargetNullValue='#'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#6B7280"/>
                                                </Border>

                                                <!-- Status -->
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="#617589" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                <!-- Teams Center -->
                                                <Grid Grid.Column="2" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Team1}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,24,0" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="Black"/>
                                                    
                                                    <!-- Quick Score -->
                                                    <Border Grid.Column="1" Background="#F9FAFB" CornerRadius="8" Padding="12,4" MinWidth="100">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Team1QuickScore}" FontWeight="Bold" FontSize="18" MinWidth="20" TextAlignment="Center" Foreground="Black"/>
                                                            <TextBlock Text=" : " FontWeight="Bold" FontSize="18" Foreground="#9CA3AF" Margin="4,0"/>
                                                            <TextBlock Text="{Binding Team2QuickScore}" FontWeight="Bold" FontSize="18" MinWidth="20" TextAlignment="Center" Foreground="Black"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Grid.Column="2" Text="{Binding Team2}" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="24,0,0,0" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="Black"/>
                                                </Grid>

                                                <!-- Edit Button -->
                                                <Button Grid.Column="3" Content="РџРѕРґСЂРѕР±РЅРµРµ" 
                                                        Command="{Binding DataContext.OpenMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource AddTeamButtonStyle}" 
                                                        Padding="16,8" Margin="24,0,0,0"
                                                        Background="#E0F2FE" Foreground="#137FEC"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Sidebar -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="РЎС‚Р°С‚РёСЃС‚РёРєР°" FontWeight="Bold" FontSize="16" Margin="0,0,0,24" Foreground="Black"/>
                            
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Р’СЃРµРіРѕ РјР°С‚С‡РµР№" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding ScheduleVM.TotalMatches}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="Black"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="РЎС‹РіСЂР°РЅРѕ" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding ScheduleVM.Played}" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <TextBlock Text="РћСЃС‚Р°Р»РѕСЃСЊ" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding ScheduleVM.NotPlayed}" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <Separator Background="#E5E7EB" Margin="0,0,0,24"/>
                            
                            <TextBlock Text="Р¤РёР»СЊС‚СЂ Рё РїРѕРёСЃРє" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="Black"/>
                            <TextBlock Text="РСЃРїРѕР»СЊР·СѓР№С‚Рµ РїРѕРёСЃРє РґР»СЏ С„РёР»СЊС‚СЂР°С†РёРё РїРѕ РЅР°Р·РІР°РЅРёСЋ РєРѕРјР°РЅРґС‹ РёР»Рё РЅРѕРјРµСЂСѓ РјР°С‚С‡Р°." FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="ResultsTab" Style="{StaticResource TailwindTabItem}">
                <TabItem.Header>
                    <TextBlock Text="Р РµР·СѓР»СЊС‚Р°С‚С‹" VerticalAlignment="Center"/>
                </TabItem.Header>

                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- РЎРѕРѕР±С‰РµРЅРёРµ -->
                        <RowDefinition Height="*"/>
                        <!-- РўР°Р±Р»РёС†Р° -->
                        <RowDefinition Height="Auto"/>
                        <!-- Р›РµРіРµРЅРґР° -->
                        <RowDefinition Height="Auto"/>
                        <!-- РљРЅРѕРїРєР° СЌРєСЃРїРѕСЂС‚Р° PNG СЃРЅРёР·Сѓ СЃР»РµРІР° -->
                    </Grid.RowDefinitions>

                    <!-- РЎРѕРѕР±С‰РµРЅРёРµ -->
                    <TextBlock Grid.Row="0" Text="{Binding CurrentResults.StatusMessage}"
                   FontSize="16"
                   Foreground="#617589"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>

                    <!-- РўР°Р±Р»РёС†Р° вЂ” РЅР° РІСЃС‘ РїСЂРѕСЃС‚СЂР°РЅСЃС‚РІРѕ -->
                    <!-- Polymorphic Results Content -->
                    <ContentControl Grid.Row="1" Content="{Binding CurrentResults}" />

                    <!-- РљРЅРѕРїРєР° Р­РєСЃРїРѕСЂС‚ (PNG) вЂ” СЃРЅРёР·Сѓ СЃР»РµРІР° -->
                    <Button Grid.Row="3"
                            Content="Р­РєСЃРїРѕСЂС‚ (PNG)"
                            Command="{Binding ExportResultsCommand}"
                            Style="{StaticResource AddTeamButtonStyle}"
                            Padding="16,10"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#3B82F6"
                            Foreground="White"/>
                </Grid>
            </TabItem>
            <TabItem Header="РЎС‚Р°С‚РёСЃС‚РёРєР°" Style="{StaticResource TailwindTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,32,0,0">
                    <Grid Margin="40,0,40,40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- РЎРІРѕРґРєР° -->
                            <RowDefinition Height="Auto"/>
                            <!-- Р›РёРґРµСЂ -->
                            <RowDefinition Height="*"/>
                            <!-- РЎРїРёСЃРєРё -->
                            <RowDefinition Height="Auto"/>
                            <!-- РљРЅРѕРїРєР° СЌРєСЃРїРѕСЂС‚Р° СЃРЅРёР·Сѓ СЃР»РµРІР° -->
                        </Grid.RowDefinitions>

                        <!-- 1. РЎРІРѕРґРєР° (СЃРІРµСЂС…Сѓ) -->
                        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <UniformGrid Rows="1">
                                <!-- РЎС‹РіСЂР°РЅРѕ -->
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="РЎС‹РіСЂР°РЅРѕ РјР°С‚С‡РµР№" FontSize="13" Foreground="#6B7280"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Statistics.PlayedMatches}" FontSize="24" FontWeight="Bold" Foreground="#111418"/>
                                        <TextBlock Text="/" FontSize="24" FontWeight="Bold" Foreground="#9CA3AF" Margin="4,0"/>
                                        <TextBlock Text="{Binding Statistics.TotalMatches}" FontSize="24" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- РћСЃС‚Р°Р»РѕСЃСЊ -->
                                <StackPanel Margin="16,0">
                                    <TextBlock Text="РћСЃС‚Р°Р»РѕСЃСЊ РјР°С‚С‡РµР№" FontSize="13" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding Statistics.RemainingMatches}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- РџСЏС‚РёСЃРµС‚РѕРІРєРё -->
                                <StackPanel Margin="16,0">
                                    <TextBlock Text="РљРѕР»РёС‡РµСЃС‚РІРѕ РїСЏС‚РёСЃРµС‚РѕРІРѕРє" FontSize="13" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding Statistics.FiveSetMatches}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- РЎСЂРµРґРЅРµРµ -->
                                <StackPanel Margin="16,0">
                                    <TextBlock Text="РЎСЂРµРґРЅСЏСЏ СЂР°Р·С‹РіСЂРѕРІРєР° РјСЏС‡РµР№" FontSize="13" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding Statistics.AvgGoals}" FontSize="24" FontWeight="Bold" Foreground="#6366F1" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- 2. Р›РёРґРµСЂ С‚СѓСЂРЅРёСЂР° (СЃРµСЂРµРґРёРЅР°) -->
                        <Border Grid.Row="1" CornerRadius="12" Margin="0,0,0,24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#28c08e" Offset="0.0"/>
                                    <!-- РЅР°С‡Р°Р»Рѕ, СЃР°РјС‹Р№ СЃРІРµС‚Р»С‹Р№ -->
                                    <GradientStop Color="#27b091" Offset="0.5"/>
                                    <!-- СЃРµСЂРµРґРёРЅР°, РѕСЃРЅРѕРІРЅРѕР№ Р°РєС†РµРЅС‚ -->
                                    <GradientStop Color="#269f94" Offset="1.0"/>
                                    <!-- РєРѕРЅРµС†, С‡СѓС‚СЊ С‚РµРјРЅРµРµ Рё "РіР»СѓР±Р¶Рµ" -->
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="White" Margin="0,0,16,0">
                                        <TextBlock Text="в™›" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#059669"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="РўР•РљРЈР©РР™ Р›РР”Р•Р " FontSize="12" FontWeight="Bold" Foreground="#D1FAE5"/>
                                        <TextBlock Text="{Binding Statistics.LeaderName}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,24,0" HorizontalAlignment="Right">
                                            <TextBlock Text="РћС‡РєРё" FontSize="12" Foreground="#D1FAE5" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Statistics.LeaderPoints}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="Р¤РѕСЂРјР°" FontSize="12" Foreground="#D1FAE5" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Statistics.LeaderForm}" FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"
                                           FontFamily="Consolas, Monospace"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- 3. РЎРїРёСЃРєРё (РўРѕРї MVP + РџРѕСЃР»РµРґРЅРёРµ РјР°С‚С‡Рё) -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- РўРѕРї MVP -->
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" VerticalAlignment="Top" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="РўРѕРї-5 MVP" FontSize="16" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>

                                    <ItemsControl ItemsSource="{Binding Statistics.TopMvps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#F3F4F6">
                                                        <TextBlock Text="{Binding PlayerName, StringFormat='{}{0:0}'}" TextTrimming="CharacterEllipsis" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#6B7280" FontSize="12"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0">
                                                        <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold" FontSize="14" Foreground="#111418"/>
                                                        <TextBlock Text="{Binding TeamName}" FontSize="12" Foreground="#6B7280"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="6" Padding="8,4">
                                                        <TextBlock Text="{Binding Count, StringFormat='{}{0} MVP'}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Р”Р°РЅРЅС‹Рµ СЃРѕР±РёСЂР°СЋС‚СЃСЏ РЅР° РѕСЃРЅРѕРІРµ РєР°СЂС‚РѕС‡РµРє РјР°С‚С‡РµР№" FontSize="11" Foreground="#9CA3AF" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- РџРѕСЃР»РµРґРЅРёРµ РјР°С‚С‡Рё -->
                            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" VerticalAlignment="Top" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="РџРѕСЃР»РµРґРЅРёРµ РјР°С‚С‡Рё" FontSize="16" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>

                                    <ItemsControl ItemsSource="{Binding Statistics.LastMatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="12" Background="#F9FAFB" CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding TeamName}" 
                                                       FontSize="14" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="1" Text="{Binding Form}" 
                                                       FontSize="13" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center" 
                                                       FontFamily="Consolas, Monospace" Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- РљРЅРѕРїРєР° СЌРєСЃРїРѕСЂС‚Р° вЂ” СЃРЅРёР·Сѓ СЃР»РµРІР° -->
                        <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        Margin="0,24,0,0">
                            <Button Content="Р­РєСЃРїРѕСЂС‚ РІ Excel"
                        Command="{Binding ExportResultsExcelCommand}"
                        Style="{StaticResource AddTeamButtonStyle}"
                        Background="#10B981"
                        Foreground="White"
                        Padding="16,12"
                        FontSize="14"
                        FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="РќР°СЃС‚СЂРѕР№РєРё" Style="{StaticResource TailwindTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="40,32,40,40" MaxWidth="900">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. РћСЃРЅРѕРІРЅР°СЏ РёРЅС„РѕСЂРјР°С†РёСЏ -->
                        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="РћСЃРЅРѕРІРЅР°СЏ РёРЅС„РѕСЂРјР°С†РёСЏ" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,20"/>

                                <!-- РќР°Р·РІР°РЅРёРµ С‚СѓСЂРЅРёСЂР° -->
                                <TextBlock Text="РќР°Р·РІР°РЅРёРµ С‚СѓСЂРЅРёСЂР°" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CurrentTournament.Name, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="14" Padding="10" Margin="0,0,0,16" 
                                         BorderBrush="#D1D5DB" BorderThickness="1"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Р”Р°С‚Р° РЅР°С‡Р°Р»Р° -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Р”Р°С‚Р° РЅР°С‡Р°Р»Р°" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <DatePicker SelectedDate="{Binding CurrentTournament.StartDate}" 
                                                    FontSize="14" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                    </StackPanel>

                                    <!-- Р”Р°С‚Р° РѕРєРѕРЅС‡Р°РЅРёСЏ -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Р”Р°С‚Р° РѕРєРѕРЅС‡Р°РЅРёСЏ" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <DatePicker SelectedDate="{Binding CurrentTournament.EndDate}" 
                                                    FontSize="14" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>

                                <!-- РњРµСЃС‚Рѕ РїСЂРѕРІРµРґРµРЅРёСЏ -->
                                <TextBlock Text="РњРµСЃС‚Рѕ РїСЂРѕРІРµРґРµРЅРёСЏ" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding AvailableCities}" 
                                          SelectedItem="{Binding CurrentTournament.Location}" 
                                          FontSize="14" Padding="10" Margin="0,0,0,0" 
                                          BorderBrush="#D1D5DB" BorderThickness="1" IsEditable="True"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. РќР°СЃС‚СЂРѕР№РєРё С„РѕСЂРјР°С‚Р° -->
                        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="РќР°СЃС‚СЂРѕР№РєРё С„РѕСЂРјР°С‚Р°" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- РўРёРї С‚СѓСЂРЅРёСЂР° -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="РўРёРї С‚СѓСЂРЅРёСЂР°" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <Border Background="#F9FAFB" CornerRadius="8" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <TextBlock Text="{Binding CurrentTournament.Type}" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Р’РёРґ СЃРїРѕСЂС‚Р° -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Р’РёРґ СЃРїРѕСЂС‚Р°" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <Border Background="#F9FAFB" CornerRadius="8" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <TextBlock Text="{Binding CurrentTournament.SportType}" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- РћС‡РєРё (РґРёРЅР°РјРёС‡РµСЃРєР°СЏ СЃРёСЃС‚РµРјР°) -->
                                <TextBlock Text="РЎРёСЃС‚РµРјР° РЅР°С‡РёСЃР»РµРЅРёСЏ РѕС‡РєРѕРІ" FontSize="13" Foreground="#6B7280" Margin="0,16,0,6"/>
                                <ComboBox ItemsSource="{Binding AvailableScoringSystems}" 
                                          SelectedItem="{Binding SelectedScoringSystem}" 
                                          Style="{DynamicResource ModernComboBox}"
                                          FontSize="14" Padding="10" Margin="0,0,0,12" 
                                          BorderBrush="#D1D5DB" BorderThickness="1"/>

                                <Border Background="#F0F9FF" CornerRadius="8" Padding="16" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="РћРїРёСЃР°РЅРёРµ РїСЂР°РІРёР»:" FontSize="12" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ScoringDescription}" FontSize="13" Foreground="#075985" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- РџРѕР»СЊР·РѕРІР°С‚РµР»СЊСЃРєРёРµ РѕС‡РєРё -->
                                <StackPanel Visibility="{Binding IsCustomScoring, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Р—Р° РїРѕР±РµРґСѓ" FontSize="12" Foreground="#6B7280"/>
                                            <TextBox Text="{Binding WinPoints}" FontSize="14" Padding="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Р—Р° РЅРёС‡СЊСЋ" FontSize="12" Foreground="#6B7280"/>
                                            <TextBox Text="{Binding DrawPoints}" FontSize="14" Padding="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Р—Р° РїРѕСЂР°Р¶РµРЅРёРµ" FontSize="12" Foreground="#6B7280"/>
                                            <TextBox Text="{Binding LossPoints}" FontSize="14" Padding="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Р”РѕРїРѕР»РЅРёС‚РµР»СЊРЅС‹Рµ РґРµР№СЃС‚РІРёСЏ -->
                        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Р”РѕРїРѕР»РЅРёС‚РµР»СЊРЅС‹Рµ РґРµР№СЃС‚РІРёСЏ" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal">
                                    <!-- Р­РєСЃРїРѕСЂС‚ СЂРµР·СѓР»СЊС‚Р°С‚РѕРІ -->
                                    <Button Content="Р­РєСЃРїРѕСЂС‚ СЂРµР·СѓР»СЊС‚Р°С‚РѕРІ" 
                                            Command="{Binding ExportResultsCommand}"
                                            Background="#10B981" Foreground="White" 
                                            FontSize="14" FontWeight="SemiBold" 
                                            Padding="16,10" BorderThickness="0" 
                                            Cursor="Hand" Margin="0,0,12,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#059669"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- РЈРґР°Р»РёС‚СЊ С‚СѓСЂРЅРёСЂ -->
                                    <Button Content="РЈРґР°Р»РёС‚СЊ С‚СѓСЂРЅРёСЂ" 
                                            Command="{Binding DeleteTournamentCommand}"
                                            Background="#EF4444" Foreground="White" 
                                            FontSize="14" FontWeight="SemiBold" 
                                            Padding="16,10" BorderThickness="0" 
                                            Cursor="Hand">
                                        <!-- РЎС‚РёР»СЊ РєРЅРѕРїРєРё СѓРґР°Р»РµРЅРёСЏ РѕСЃС‚Р°РІР»РµРЅ РїСЂРµР¶РЅРёРј -->
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DC2626"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 5. РљРЅРѕРїРєРё СЃРѕС…СЂР°РЅРµРЅРёСЏ/РѕС‚РјРµРЅС‹ -->
                        <Border Grid.Row="4" Background="#F9FAFB" CornerRadius="12" Padding="24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- РћС‚РјРµРЅР° -->
                                <Button Content="РћС‚РјРµРЅР°" 
                                        Command="{Binding CancelSettingsCommand}"
                                        Background="White" Foreground="#374151" 
                                        FontSize="14" FontWeight="SemiBold" 
                                        Padding="20,10" BorderThickness="1" BorderBrush="#D1D5DB"
                                        Cursor="Hand" Margin="0,0,12,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- РЎРѕС…СЂР°РЅРёС‚СЊ -->
                                <Button Content="РЎРѕС…СЂР°РЅРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ" 
                                        Command="{Binding SaveSettingsCommand}"
                                        Background="#3B82F6" Foreground="White" 
                                        FontSize="14" FontWeight="SemiBold" 
                                        Padding="20,10" BorderThickness="0" 
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
