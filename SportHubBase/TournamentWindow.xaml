
    <Window x:Class="SportHubBase.TournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SportHubBase.Converters;assembly=SportHubBase"
        Title="{Binding CurrentTournament.Name}"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="#F6F7F8"
        FontFamily="Inter, Segoe UI"
        MinWidth="1200"
        MinHeight="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Header -->
        <Border Background="White" Height="80" VerticalAlignment="Top">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#137FEC" Margin="0,0,12,0">
                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                </StackPanel>
            </Grid>
        </Border>

        <!-- Название турнира -->
        <StackPanel Margin="40,100,40,0">
            <TextBlock Text="{Binding CurrentTournament.Name}"
                       FontSize="36" FontWeight="Black" Foreground="#111418"/>
        </StackPanel>

        <!-- TabControl -->
        <TabControl Style="{StaticResource TailwindTabControl}"
                    Margin="0,200,0,0"
                    SelectedIndex="0"
                    SelectionChanged="TabControl_SelectionChanged">

            <TabItem Header="Главная" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Команды -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Teams}" AlternationCount="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="8"
                                                Padding="12"
                                                CornerRadius="8"
                                                Background="#F9FAFB"
                                                Cursor="Hand"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                            <!-- Клик левой кнопкой мыши → команда EditTeamCommand -->
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                          Command="{Binding DataContext.EditTeamCommand, 
                                                            RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          CommandParameter="{Binding}"/>
                                            </Border.InputBindings>

                                            <!-- Управление внешним видом при наведении и нажатии -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F9FAFB"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Effect" Value="{x:Null}"/>

                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                            <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <!-- Содержимое карточки -->
                                            <StackPanel>
                                                <Border Width="80" Height="80" 
                                    CornerRadius="40" 
                                    Margin="0,0,0,12" 
                                    Background="#F0F2F4"
                                    HorizontalAlignment="Center">
                                                    <TextBlock Text="T" 
                                           Foreground="#617589" 
                                           FontSize="32"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                                                <TextBlock Text="{Binding Name}" 
                                       FontWeight="Medium" 
                                       FontSize="14"
                                       TextAlignment="Center" 
                                       Foreground="#111418"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>

                                                <TextBlock Text="{Binding Captain}" 
                                       FontSize="13" 
                                       Foreground="#617589" 
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Сайдбар на русском -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" Margin="24,0,0,0">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Количество команд" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="{Binding TeamsCount}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Формат" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="{Binding FormatText}" FontSize="18" FontWeight="Bold" Foreground="#111418"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="Даты проведения" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="{Binding DatesText}" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#111418"
                                           TextWrapping="Wrap"/>
                                <!-- Важно: Wrap, чтобы переносился на новую строку -->
                            </StackPanel>

                            <Button Command="{Binding AddTeamCommand}"
                                    Style="{StaticResource AddTeamButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Добавить команду"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка расписания -->
            <TabItem Header="Расписание" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Сообщение (для заглушек и ошибок) -->
                    <TextBlock Text="{Binding ScheduleMessage}"
                   FontSize="16"
                   Foreground="#617589"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"/>

                    <!-- Карточки матчей -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Schedule}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Основная карточка с hover-эффектом -->
                                    <Border Margin="0,0,0,12"
                                Padding="16"
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                                        <!-- Hover-эффект: утолщение и смена цвета границы -->
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="2" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#137FEC" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="1" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E5E7EB" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Статус -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Команды + счёт -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Кнопка -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Статус матча (слева) -->
                                            <TextBlock Grid.Column="0"
                                           Text="{Binding Status}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#617589"
                                           VerticalAlignment="Center"
                                           Margin="0,0,32,0"/>

                                            <!-- Центральная часть: команды + быстрый счёт -->
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Команда 1 -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Счёт -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Команда 2 -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Команда 1 (выровнена вправо) -->
                                                <TextBlock Grid.Column="0"
                                               Text="{Binding Team1}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#111418"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,24,0"
                                               TextTrimming="CharacterEllipsis"/>

                                                <!-- Быстрый счёт по центру -->
                                                <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                    <!-- Поле ввода 1 со скруглением -->
                                                    <Border Width="48"
                                                Height="48"
                                                CornerRadius="8"
                                                Background="#F8F9FA"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="2"
                                                Margin="0,0,12,0">
                                                        <TextBox Text="{Binding Team1QuickScore, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontSize="18"
                                                     FontWeight="Bold"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Text="-"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#617589"
                                                   VerticalAlignment="Center"/>

                                                    <!-- Поле ввода 2 со скруглением -->
                                                    <Border Width="48"
                                                Height="48"
                                                CornerRadius="8"
                                                Background="#F8F9FA"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="2"
                                                Margin="12,0,0,0">
                                                        <TextBox Text="{Binding Team2QuickScore, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontSize="18"
                                                     FontWeight="Bold"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Команда 2 (выровнена влево) -->
                                                <TextBlock Grid.Column="2"
                                               Text="{Binding Team2}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#111418"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="24,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                            </Grid>

                                            <!-- Кнопка "Открыть карточку" справа -->
                                            <Border Grid.Column="2"
                                        CornerRadius="8"
                                        Background="#E0F2FE">
                                                <Button Content="Открыть карточку"
                                                        Style="{StaticResource AddTeamButtonStyle}"
                                                        Padding="12,8"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#137FEC"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.OpenMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="ResultsTab" Style="{StaticResource TailwindTabItem}">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Результаты" VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Content="Экспорт"
                                Command="{Binding ExportResultsCommand}"
                                Visibility="{Binding ElementName=ResultsTab, Path=IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource AddTeamButtonStyle}"
                                Padding="8,4"
                                Margin="8,0,0,0"
                                FontSize="12"/>
                    </Grid>
                </TabItem.Header>
                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Сообщение -->
                    <TextBlock Grid.Row="0" Text="{Binding ResultsMessage}"
                   FontSize="16"
                   Foreground="#617589"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>

                    <!-- Таблица — на всё пространство -->
                    <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Заголовок -->
                                <RowDefinition Height="*"/>
                                <!-- Тело -->
                            </Grid.RowDefinitions>

                            <!-- Заголовок таблицы -->
                            <Border Grid.Row="0"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <!-- Rk. -->
                                        <ColumnDefinition Width="280"/>
                                        <!-- Команда -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Шахматная таблица (номера команд) -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- В -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- П -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- ВП -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- ПП -->
                                        <ColumnDefinition Width="70"/>
                                        <!-- Очки -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Rk. -->
                                    <Border Grid.Column="0"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="16,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="№"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Команда -->
                                    <Border Grid.Column="1"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="16,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="Команда"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Left"/>
                                    </Border>

                                    <!-- Номера столбцов шахматной таблицы -->
                                    <ScrollViewer Grid.Column="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding ResultsHeaderNumbers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="60"
                                                Height="70"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                Background="#F9FAFB">
                                                        <TextBlock Text="{Binding}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#617589"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- В -->
                                    <Border Grid.Column="3"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="В"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Выигранные матчи"/>
                                    </Border>

                                    <!-- П -->
                                    <Border Grid.Column="4"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="П"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Проигранные матчи"/>
                                    </Border>

                                    <!-- ВП -->
                                    <Border Grid.Column="5"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="ВП"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Выигранные партии/сеты"/>
                                    </Border>

                                    <!-- ПП -->
                                    <Border Grid.Column="6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="ПП"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Проигранные партии/сеты"/>
                                    </Border>

                                    <!-- Очки -->
                                    <Border Grid.Column="7"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="Очки"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Очки по итальянской системе"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Тело таблицы -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultsTable}" Margin="0,5,0,-5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1"
                                    Background="White"
                                    x:Name="RowBorder">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Height="70">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <!-- Rk. -->
                                                    <ColumnDefinition Width="280"/>
                                                    <!-- Команда -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Шахматная таблица -->
                                                    <ColumnDefinition Width="60"/>
                                                    <!-- В -->
                                                    <ColumnDefinition Width="60"/>
                                                    <!-- П -->
                                                    <ColumnDefinition Width="60"/>
                                                    <!-- ВП -->
                                                    <ColumnDefinition Width="60"/>
                                                    <!-- ПП -->
                                                    <ColumnDefinition Width="70"/>
                                                    <!-- Очки -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Место -->
                                                <Border Grid.Column="0"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="0,0,1,0"
                                                        Background="White">
                                                    <Border Width="32"
                                                            Height="32"
                                                            CornerRadius="6"
                                                            Background="#F3F4F6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Place}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="#111418"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Border>

                                                <!-- Название команды -->
                                                <Border Grid.Column="1"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding TeamName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="16,0"/>
                                                </Border>

                                                <!-- Шахматная таблица (ячейки) -->
                                                <ScrollViewer Grid.Column="2"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Hidden">
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="57"
                                                                          Height="60"
                                                                          Margin="0,0,4,0"
                                                                          BorderBrush="#E5E7EB"
                                                                          BorderThickness="0,0,1,0"
                                                                          Background="{Binding Converter={StaticResource ResultCellBackgroundConverter}}"
                                                                          x:Name="CellBorder">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Path Data="M0,0 L60,60 M0,60 L60,0"
                                                                  Stroke="#E5E7EB"
                                                                  StrokeThickness="1.5"
                                                                  Stretch="None"
                                                                  Visibility="Collapsed"
                                                                  x:Name="DiagonalLines">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding}" Value="SELF">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                        <TextBlock HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="15"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{Binding Converter={StaticResource ResultCellColorConverter}}"
                                                                                   Text="{Binding DisplayText}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                                            <Setter Property="Text" Value=""/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Outcome}" Value="NOT_PLAYED">
                                                                                            <Setter Property="Text" Value="-"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <!-- В -->
                                                <Border Grid.Column="3"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding Wins}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- П -->
                                                <Border Grid.Column="4"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding Losses}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- ВП -->
                                                <Border Grid.Column="5"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding SetsWon}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- ПП -->
                                                <Border Grid.Column="6"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding SetsLost}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Очки -->
                                                <Border Grid.Column="7"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,0,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding Points}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#137FEC"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- Легенда (остаётся внизу) -->
                    <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16"
                Background="#F9FAFB"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Легенда:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#617589"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Победа (1)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#617589" Opacity="0.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ничья (½)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#F43F5E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Поражение (0)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Статистика" Style="{StaticResource TailwindTabItem}">
                <!-- Волейбол -->
                <Grid>
                    <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Сетка карточек -->
                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tournament Overview -->
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Обзор турнира" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>

                                    <!-- Total Matches Played -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Всего матчей сыграно" FontSize="13" Foreground="#617589"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalMatchesPlayed}" FontSize="13" FontWeight="Bold" Foreground="#111418"/>
                                    </Grid>

                                    <!-- Total Sets Played -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Всего сетов сыграно" FontSize="13" Foreground="#617589"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalSetsPlayed}" FontSize="13" FontWeight="Bold" Foreground="#111418"/>
                                    </Grid>

                                    <!-- Total Points Scored -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Всего очков набрано" FontSize="13" Foreground="#617589"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalPointsScored, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="Bold" Foreground="#111418"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Most Valuable Player -->
                            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Самый ценный игрок" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="80" Height="80" CornerRadius="40" Background="#F0F2F4" Margin="0,0,16,0">
                                            <TextBlock Text="P" Foreground="#617589" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MostValuablePlayerName}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                                            <TextBlock Text="{Binding MostValuablePlayerTeam, StringFormat='из команды {0}'}" FontSize="13" Foreground="#617589"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="#F9FAFB" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Количество MVP" FontSize="11" Foreground="#617589" TextAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MostValuablePlayerCount}" FontSize="20" FontWeight="Bold" Foreground="#111418" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Most Popular Team -->
                            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Сыграла больше всех матчей" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="80" Height="80" CornerRadius="40" Background="#F0F2F4" Margin="0,0,16,0">
                                            <TextBlock Text="T" Foreground="#617589" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MostPopularTeamName}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="МАТЧЕЙ СЫГРАНО" FontSize="11" Foreground="#617589" TextAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding MostPopularTeamMatchesPlayed}" FontSize="20" FontWeight="Bold" Foreground="#111418" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#F9FAFB" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="% ПОБЕД" FontSize="11" Foreground="#617589" TextAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding MostPopularTeamWinPercentage, StringFormat='{}{0:F1}%'}" FontSize="20" FontWeight="Bold" Foreground="#111418" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
            </Grid>
                
            </TabItem>
            <TabItem Header="Настройки" Style="{StaticResource TailwindTabItem}">
                <TextBlock Text="Настройки — в разработке" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>