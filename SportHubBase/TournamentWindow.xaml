<Window x:Class="SportHubBase.TournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SportHubBase.Converters"
        Title="{Binding CurrentTournament.Name}"
        Height="950" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F8"
        FontFamily="Inter, Segoe UI">

    <Grid>
        <!-- Header -->
        <Border Background="White" Height="80" VerticalAlignment="Top">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#137FEC" Margin="0,0,12,0">
                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                </StackPanel>
            </Grid>
        </Border>

        <!-- Название турнира -->
        <StackPanel Margin="40,100,40,0">
            <TextBlock Text="{Binding CurrentTournament.Name}"
                       FontSize="36" FontWeight="Black" Foreground="#111418"/>
        </StackPanel>

        <!-- TabControl -->
        <TabControl Style="{StaticResource TailwindTabControl}"
                    Margin="0,200,0,0"
                    SelectedIndex="0">

            <TabItem Header="Главная" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Команды -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Teams}" AlternationCount="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Command="{Binding DataContext.EditTeamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Margin="8" Padding="12" CornerRadius="8"
                                                    Background="#F9FAFB">
                                                <StackPanel>
                                                    <Border Width="80" Height="80" CornerRadius="40" Margin="0,0,0,12" Background="#F0F2F4">
                                                        <TextBlock Text="T" Foreground="#617589" FontSize="24" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextAlignment="Center" Foreground="#111418"/>
                                                    <TextBlock Text="{Binding Captain}" FontSize="13" Foreground="#617589" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Сайдбар на русском -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" Margin="24,0,0,0">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Количество команд" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="{Binding TeamsCount}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Формат" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="{Binding FormatText}" FontSize="18" FontWeight="Bold" Foreground="#111418"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="Даты проведения" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="{Binding DatesText}" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#111418"
                                           TextWrapping="Wrap"/>
                                <!-- Важно: Wrap, чтобы переносился на новую строку -->
                            </StackPanel>

                            <Button Command="{Binding AddTeamCommand}"
                                    Background="#137FEC20" Foreground="#137FEC" FontWeight="Bold" Padding="20,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Добавить команду"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка расписания -->
            <TabItem Header="Расписание" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Сообщение (для заглушек и ошибок) -->
                    <TextBlock Text="{Binding ScheduleMessage}"
                   FontSize="16"
                   Foreground="#617589"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"/>

                    <!-- Карточки матчей -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Schedule}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Основная карточка с hover-эффектом -->
                                    <Border Margin="0,0,0,12"
                                Padding="16"
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                                        <!-- Hover-эффект: утолщение и смена цвета границы -->
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="2" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#137FEC" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="1" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E5E7EB" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Статус -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Команды + счёт -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Кнопка -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Статус матча (слева) -->
                                            <TextBlock Grid.Column="0"
                                           Text="{Binding Status}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#617589"
                                           VerticalAlignment="Center"
                                           Margin="0,0,32,0"/>

                                            <!-- Центральная часть: команды + быстрый счёт -->
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Команда 1 -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Счёт -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Команда 2 -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Команда 1 (выровнена вправо) -->
                                                <TextBlock Grid.Column="0"
                                               Text="{Binding Team1}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#111418"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,24,0"
                                               TextTrimming="CharacterEllipsis"/>

                                                <!-- Быстрый счёт по центру -->
                                                <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                    <!-- Поле ввода 1 со скруглением -->
                                                    <Border Width="48"
                                                Height="48"
                                                CornerRadius="8"
                                                Background="#F8F9FA"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="2"
                                                Margin="0,0,12,0">
                                                        <TextBox Text="{Binding Team1QuickScore, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontSize="18"
                                                     FontWeight="Bold"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Text="-"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#617589"
                                                   VerticalAlignment="Center"/>

                                                    <!-- Поле ввода 2 со скруглением -->
                                                    <Border Width="48"
                                                Height="48"
                                                CornerRadius="8"
                                                Background="#F8F9FA"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="2"
                                                Margin="12,0,0,0">
                                                        <TextBox Text="{Binding Team2QuickScore, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontSize="18"
                                                     FontWeight="Bold"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Команда 2 (выровнена влево) -->
                                                <TextBlock Grid.Column="2"
                                               Text="{Binding Team2}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#111418"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="24,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                            </Grid>

                                            <!-- Кнопка "Открыть карточку" справа -->
                                            <Border Grid.Column="2"
                                        CornerRadius="8"
                                        Background="#137FEC20">
                                                <Button Content="Открыть карточку"
                                            Padding="12,8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#137FEC"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.OpenMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Результаты" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Сообщение (для заглушек и ошибок) -->
                    <TextBlock Grid.Row="0" Text="{Binding ResultsMessage}"
                               FontSize="16"
                               Foreground="#617589"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>

                    <!-- Красивая таблица результатов (центрированная) -->
                    <ScrollViewer Grid.Row="1" 
                                  HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto">
                        <Border Background="White" 
                                CornerRadius="12" 
                                BorderBrush="#E5E7EB" 
                                BorderThickness="1"
                                Padding="0"
                                HorizontalAlignment="Center"
                                MaxWidth="1200">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Заголовок таблицы -->
                            <Border Grid.Row="0" 
                                    Background="#F9FAFB" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="0,0,0,1"
                                    Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Заголовок "Rk." -->
                                    <Border Grid.Column="0" 
                                            BorderBrush="#E5E7EB" 
                                            BorderThickness="0,0,1,0"
                                            Padding="12,14"
                                            Background="#F9FAFB">
                                        <TextBlock Text="Rk." 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#617589" 
                                                   HorizontalAlignment="Left"/>
                                    </Border>

                                    <!-- Заголовок "Команда" -->
                                    <Border Grid.Column="1" 
                                            BorderBrush="#E5E7EB" 
                                            BorderThickness="0,0,1,0"
                                            Padding="12,14"
                                            Background="#F9FAFB">
                                        <TextBlock Text="Команда" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#617589" 
                                                   HorizontalAlignment="Left"/>
                                    </Border>

                                    <!-- Заголовки номеров столбцов (прокручиваемые) -->
                                    <ScrollViewer Grid.Column="2" 
                                                  HorizontalScrollBarVisibility="Auto" 
                                                  VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding ResultsHeaderNumbers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="48" 
                                                            Height="48" 
                                                            BorderBrush="#E5E7EB" 
                                                            BorderThickness="0,0,1,0"
                                                            Background="#F9FAFB"
                                                            Padding="0">
                                                        <TextBlock Text="{Binding}" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   FontSize="11" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="#617589"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Тело таблицы -->
                            <ScrollViewer Grid.Row="1" 
                                          HorizontalScrollBarVisibility="Auto" 
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ResultsTable}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E5E7EB" 
                                                    BorderThickness="0,0,0,1"
                                                    Background="White"
                                                    x:Name="RowBorder">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="240"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Номер строки (sticky) -->
                                                    <Border Grid.Column="0" 
                                                            BorderBrush="#E5E7EB" 
                                                            BorderThickness="0,0,1,0"
                                                            Padding="12,14"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}">
                                                        <Border Width="24" 
                                                                Height="24" 
                                                                CornerRadius="4" 
                                                                Background="#F3F4F6"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Index}" 
                                                                       FontSize="12" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#111418"
                                                                       HorizontalAlignment="Center" 
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Border>

                                                    <!-- Название команды (sticky) -->
                                                    <Border Grid.Column="1" 
                                                            BorderBrush="#E5E7EB" 
                                                            BorderThickness="0,0,1,0"
                                                            Padding="12,14"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}">
                                                        <TextBlock Text="{Binding TeamName}" 
                                                                   FontSize="14" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="#111418"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Ячейки результатов (прокручиваемые) -->
                                                    <ScrollViewer Grid.Column="2" 
                                                                  HorizontalScrollBarVisibility="Auto" 
                                                                  VerticalScrollBarVisibility="Hidden">
                                                        <ItemsControl ItemsSource="{Binding Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                    
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="48" 
                                                                            Height="48" 
                                                                            BorderBrush="#E5E7EB" 
                                                                            BorderThickness="0,0,1,0"
                                                                            Background="{Binding Converter={StaticResource ResultCellBackgroundConverter}}"
                                                                            Padding="0"
                                                                            x:Name="CellBorder">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <!-- Диагональные линии для Self ячеек (команда против себя) -->
                                                                            <Path Data="M0,0 L48,48 M0,48 L48,0" 
                                                                                  Stroke="#E5E7EB" 
                                                                                  StrokeThickness="1"
                                                                                  Stretch="Fill"
                                                                                  Opacity="0.5"
                                                                                  Visibility="Collapsed"
                                                                                  x:Name="DiagonalLines">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding}" Value="SELF">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>
                                                                            
                                                                            <!-- Текст результата -->
                                                                            <TextBlock HorizontalAlignment="Center" 
                                                                                       VerticalAlignment="Center" 
                                                                                       FontSize="14" 
                                                                                       FontWeight="Medium"
                                                                                       Foreground="{Binding Converter={StaticResource ResultCellColorConverter}}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="{Binding}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding}" Value="SELF">
                                                                                                <Setter Property="Text" Value=""/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding}" Value="">
                                                                                                <Setter Property="Text" Value=""/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    </ScrollViewer>

                    <!-- Легенда -->
                    <Border Grid.Row="2" 
                            Margin="0,16,0,0"
                            Padding="16"
                            Background="#F9FAFB"
                            CornerRadius="8"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            MaxWidth="1200">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Легенда:" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="#617589" 
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <Border Width="12" 
                                        Height="12" 
                                        CornerRadius="2" 
                                        Background="#10B981" 
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="Победа (1)" 
                                           FontSize="12" 
                                           Foreground="#617589"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <Border Width="12" 
                                        Height="12" 
                                        CornerRadius="2" 
                                        Background="#617589" 
                                        Opacity="0.5"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="Ничья (½)" 
                                           FontSize="12" 
                                           Foreground="#617589"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" 
                                        Height="12" 
                                        CornerRadius="2" 
                                        Background="#F43F5E" 
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="Поражение (0)" 
                                           FontSize="12" 
                                           Foreground="#617589"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Статистика" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Сетка карточек -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tournament Overview -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Обзор турнира" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>
                                
                                <!-- Total Matches Played -->
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Всего матчей сыграно" FontSize="13" Foreground="#617589"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalMatchesPlayed}" FontSize="13" FontWeight="Bold" Foreground="#111418"/>
                                    </Grid>
                                    <Border Height="10" Background="#E5E7EB" CornerRadius="5" ClipToBounds="True">
                                        <Border Width="{Binding TotalMatchesPlayed, Converter={StaticResource ProgressConverter}, ConverterParameter=120}" 
                                                Height="10" Background="#137FEC" CornerRadius="5" HorizontalAlignment="Left"/>
                                    </Border>
                                </StackPanel>

                                <!-- Total Sets Played -->
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Всего сетов сыграно" FontSize="13" Foreground="#617589"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalSetsPlayed}" FontSize="13" FontWeight="Bold" Foreground="#111418"/>
                                    </Grid>
                                    <Border Height="10" Background="#E5E7EB" CornerRadius="5" ClipToBounds="True">
                                        <Border Width="{Binding TotalSetsPlayed, Converter={StaticResource ProgressConverter}, ConverterParameter=458}" 
                                                Height="10" Background="#137FEC" CornerRadius="5" HorizontalAlignment="Left"/>
                                    </Border>
                                </StackPanel>

                                <!-- Total Points Scored -->
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Всего очков набрано" FontSize="13" Foreground="#617589"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalPointsScored, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="Bold" Foreground="#111418"/>
                                    </Grid>
                                    <Border Height="10" Background="#E5E7EB" CornerRadius="5" ClipToBounds="True">
                                        <Border Width="{Binding TotalPointsScored, Converter={StaticResource ProgressConverter}, ConverterParameter=12430}" 
                                                Height="10" Background="#137FEC" CornerRadius="5" HorizontalAlignment="Left"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Most Valuable Player -->
                        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Самый ценный игрок" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="#F0F2F4" Margin="0,0,16,0">
                                        <TextBlock Text="P" Foreground="#617589" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MostValuablePlayerName}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                                        <TextBlock Text="{Binding MostValuablePlayerTeam, StringFormat='из команды {0}'}" FontSize="13" Foreground="#617589"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="#F9FAFB" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="МАКС. ЭЙСОВ" FontSize="11" Foreground="#617589" TextAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="32" FontSize="20" FontWeight="Bold" Foreground="#111418" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Most Popular Team -->
                        <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Самая популярная команда" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="#F0F2F4" Margin="0,0,16,0">
                                        <TextBlock Text="T" Foreground="#617589" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MostPopularTeamName}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="МАТЧЕЙ СЫГРАНО" FontSize="11" Foreground="#617589" TextAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MostPopularTeamMatchesPlayed}" FontSize="20" FontWeight="Bold" Foreground="#111418" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Grid.Column="2" Background="#F9FAFB" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="% ПОБЕД" FontSize="11" Foreground="#617589" TextAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MostPopularTeamWinPercentage, StringFormat='{}{0:F1}%'}" FontSize="20" FontWeight="Bold" Foreground="#111418" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Leaderboard Table -->
                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Таблица лидеров" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>
                            
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Header -->
                                    <Border Grid.Column="0" Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="#F9FAFB">
                                        <TextBlock Text="Ранг" FontSize="11" FontWeight="SemiBold" Foreground="#617589"/>
                                    </Border>
                                    <Border Grid.Column="1" Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="#F9FAFB">
                                        <TextBlock Text="Игрок" FontSize="11" FontWeight="SemiBold" Foreground="#617589"/>
                                    </Border>
                                    <Border Grid.Column="2" Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="#F9FAFB">
                                        <TextBlock Text="Убийства" FontSize="11" FontWeight="SemiBold" Foreground="#617589" TextAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="3" Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="#F9FAFB">
                                        <TextBlock Text="Блоки" FontSize="11" FontWeight="SemiBold" Foreground="#617589" TextAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="4" Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="#F9FAFB">
                                        <TextBlock Text="Эйсы" FontSize="11" FontWeight="SemiBold" Foreground="#617589" TextAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="5" Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="#F9FAFB">
                                        <TextBlock Text="Дайги" FontSize="11" FontWeight="SemiBold" Foreground="#617589" TextAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="6" Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="#F9FAFB">
                                        <TextBlock Text="Ассисты" FontSize="11" FontWeight="SemiBold" Foreground="#617589" TextAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="7" Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="#F9FAFB">
                                        <TextBlock Text="Ошибки" FontSize="11" FontWeight="SemiBold" Foreground="#617589" TextAlignment="Center"/>
                                    </Border>

                                    <!-- Placeholder row -->
                                    <Border Grid.Column="0" Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="White">
                                        <TextBlock Text="1" FontWeight="Bold" Foreground="#111418"/>
                                    </Border>
                                    <Border Grid.Column="1" Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="White">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#F0F2F4" Margin="0,0,12,0">
                                                <TextBlock Text="P" Foreground="#617589" FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="—" FontWeight="Medium" Foreground="#111418"/>
                                                <TextBlock Text="—" FontSize="11" Foreground="#617589"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="White">
                                        <TextBlock Text="—" TextAlignment="Center" Foreground="#111418"/>
                                    </Border>
                                    <Border Grid.Column="3" Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="White">
                                        <TextBlock Text="—" TextAlignment="Center" Foreground="#111418"/>
                                    </Border>
                                    <Border Grid.Column="4" Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="White">
                                        <TextBlock Text="—" TextAlignment="Center" Foreground="#111418"/>
                                    </Border>
                                    <Border Grid.Column="5" Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="White">
                                        <TextBlock Text="—" TextAlignment="Center" Foreground="#111418"/>
                                    </Border>
                                    <Border Grid.Column="6" Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="White">
                                        <TextBlock Text="—" TextAlignment="Center" Foreground="#111418"/>
                                    </Border>
                                    <Border Grid.Column="7" Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,14" Background="White">
                                        <TextBlock Text="—" TextAlignment="Center" FontWeight="Bold" Foreground="#F43F5E"/>
                                    </Border>

                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="8" Grid.Row="2" 
                                               Text="Статистика игроков будет доступна после добавления детальной статистики в матчи" 
                                               FontSize="14" Foreground="#617589" 
                                               TextAlignment="Center" 
                                               Margin="0,24,0,0"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Настройки" Style="{StaticResource TailwindTabItem}">
                <TextBlock Text="Настройки — в разработке" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>