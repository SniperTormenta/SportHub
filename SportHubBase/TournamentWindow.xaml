<Window x:Class="SportHubBase.TournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Summer Cyber Cup 2024"
        Height="950" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F8"
        FontFamily="Inter, Segoe UI">

    <Grid>
        <!-- Header -->
        <Border Background="White" Height="80" VerticalAlignment="Top">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Простая иконка или лого -->
                    <Border Width="32" Height="32" CornerRadius="8" Background="#137FEC" Margin="0,0,12,0">
                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="18" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CyberTournaments" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Share" Background="#137FEC" Foreground="White" FontWeight="Bold" Padding="16,10" Margin="0,0,12,0"/>
                    <Button Content="Edit Tournament" Background="#F0F2F4" Foreground="#111418" FontWeight="Bold" Padding="16,10" Margin="0,0,12,0"/>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#137FEC">
                        <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="16" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Title + Live Badge -->
        <StackPanel Margin="40,100,40,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Summer Cyber Cup 2024" FontSize="36" FontWeight="Black" Foreground="#111418"/>

                <!-- Live Badge — скруглённый прямоугольник -->
                <Border x:Name="LiveBadge" 
                        Background="#DCFCE7" 
                        CornerRadius="9999" 
                        Padding="16,8" 
                        Margin="24,0,0,0"
                        Visibility="Visible">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#22C55E" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"/>
                        <TextBlock Text="Live" Foreground="#166534" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="August 15 - August 22, 2024" Foreground="#617589" Margin="0,8,0,32"/>
        </StackPanel>

        <!-- TabControl -->
        <TabControl Style="{StaticResource TailwindTabControl}" 
                    Margin="0,200,0,0"
                    SelectedIndex="0" >

            <TabItem Header="Главная" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Teams Grid -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                        <ScrollViewer>
                            <ItemsControl AlternationCount="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="8" Padding="12" CornerRadius="8"
                                                Background="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}, 
                                                                     Path=(ItemsControl.AlternationIndex), 
                                                                     Converter={StaticResource AlternationIndexToBackground}}">
                                            <StackPanel>
                                                <Border Width="80" Height="80" CornerRadius="40" Margin="0,0,0,12" Background="#F0F2F4">
                                                    <TextBlock Text="T" Foreground="#617589" FontSize="24" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Team Name" FontWeight="Medium" TextAlignment="Center" Foreground="#111418"/>
                                                <TextBlock Text="Captain Name" FontSize="13" Foreground="#617589" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Sidebar -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" Margin="24,0,0,0">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Total Teams" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="16 / 16" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Format" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="Single Elimination" FontSize="18" FontWeight="Bold" Foreground="#111418"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="Dates" Foreground="#617589" FontSize="13"/>
                                <TextBlock Text="Aug 15-22, 2024" FontSize="18" FontWeight="Bold" Foreground="#111418"/>
                            </StackPanel>

                            <Button Background="#137FEC20" Foreground="#137FEC" FontWeight="Bold" Padding="20,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add Team"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Расписание" Style="{StaticResource TailwindTabItem}">
                <TextBlock Text="Расписание — в разработке" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
            </TabItem>

            <TabItem Header="Результаты" Style="{StaticResource TailwindTabItem}">
                <TextBlock Text="Результаты — в разработке" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
            </TabItem>

            <TabItem Header="Настройки" Style="{StaticResource TailwindTabItem}">
                <TextBlock Text="Настройки — в разработке" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>