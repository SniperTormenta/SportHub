
    <Window x:Class="SportHubBase.TournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SportHubBase.Converters;assembly=SportHubBase"
        Title="{Binding CurrentTournament.Name}"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="#F6F7F8"
        FontFamily="Inter, Segoe UI"
        MinWidth="1200"
        MinHeight="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Header -->
        <Border Background="White" Height="80" VerticalAlignment="Top">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#137FEC" Margin="0,0,12,0">
                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                </StackPanel>
            </Grid>
        </Border>

        <!-- Название турнира -->
        <StackPanel Margin="40,100,40,0">
            <TextBlock Text="{Binding CurrentTournament.Name}"
                       FontSize="36" FontWeight="Black" Foreground="#111418"/>
        </StackPanel>

        <!-- TabControl -->
        <TabControl Style="{StaticResource TailwindTabControl}"
                    Margin="0,200,0,0"
                    SelectedIndex="0"
                    SelectionChanged="TabControl_SelectionChanged">

            <TabItem Header="Главная" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- Карточки команд -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Teams}" AlternationCount="2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6"
                                        Padding="10"
                                        CornerRadius="8"
                                        Background="#F9FAFB"
                                        Cursor="Hand"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.EditTeamCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      CommandParameter="{Binding}"/>
                                                </Border.InputBindings>

                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F9FAFB"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="Effect" Value="{x:Null}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel>
                                                    <Border Width="72" Height="72"
                                                CornerRadius="36"
                                                Margin="0,0,0,10"
                                                Background="#F0F2F4"
                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="T"
                                                       Foreground="#617589"
                                                       FontSize="30"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding Name}"
                                                   FontWeight="Medium"
                                                   FontSize="13"
                                                   TextAlignment="Center"
                                                   Foreground="#111418"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,3"/>

                                                    <TextBlock Text="{Binding Captain}"
                                                   FontSize="12"
                                                   Foreground="#617589"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Сайдбар справа -->
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" Margin="24,0,0,0">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="Статус" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding TournamentStatusText}" FontSize="20" FontWeight="Bold" Foreground="#137FEC"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="Количество команд" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding TeamsCount}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="Сыграно матчей" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding MatchesProgressText}" FontSize="20" FontWeight="Bold" Foreground="#111418"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="Лидер турнира" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding LeaderText}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="Формат" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding FormatText}" FontSize="18" FontWeight="Bold" Foreground="#111418"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,40">
                                    <TextBlock Text="Даты проведения" Foreground="#617589" FontSize="13"/>
                                    <TextBlock Text="{Binding DatesText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111418"
                                   TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Command="{Binding AddTeamCommand}"
                            Style="{StaticResource AddTeamButtonStyle}"
                            Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Добавить команду"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding FinishTournamentCommand}"
                            Style="{StaticResource AddTeamButtonStyle}"
                            Background="#FFF1F2"
                            Foreground="#E11D48"
                            BorderBrush="#FECDD3"
                            BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏁" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Завершить турнир"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Нижние кнопки импорта/экспорта -->
                    <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                        <Button Command="{Binding ImportTeamsExcelCommand}"
                    Style="{StaticResource AddTeamButtonStyle}"
                    Margin="0,0,12,0"
                    Background="#F3F4F6"
                    Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Импорт команд (Excel)"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportTeamsExcelCommand}"
                    Style="{StaticResource AddTeamButtonStyle}"
                    Margin="0,0,12,0"
                    Background="#F3F4F6"
                    Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Экспорт команд (Excel)"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DownloadTemplateCommand}"
                    Style="{StaticResource AddTeamButtonStyle}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                            <TextBlock Text="Скачать шаблон для импорта"
                           FontSize="13"
                           Foreground="#137FEC"
                           TextDecorations="Underline"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка расписания -->
            <TabItem Header="Расписание" Style="{StaticResource TailwindTabItem}">
                <Grid Margin="40,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Main Content -->
                    <Grid Grid.Column="0" Margin="0,0,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Controls: Search & Filter -->
                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Height="48" Margin="0,0,16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" Margin="12,0,8,0" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                                    <TextBox Text="{Binding ScheduleVM.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                             FontSize="14" Grid.Column="1"
                                             Tag="Поиск..."/>
                                </Grid>
                            </Border>

                            <!-- Refresh Button -->
                            <Button Grid.Column="1" Content="↺" 
                                    Command="{Binding ScheduleVM.RefreshCommand}"
                                    Style="{StaticResource DefaultModernButton}"
                                    Padding="12,0" Height="48" Margin="0,0,16,0"
                                    ToolTip="Обновить расписание"/>

                            <!-- Filter -->
                            <ComboBox Grid.Column="2" 
                                      ItemsSource="{Binding ScheduleVM.FilterOptions}"
                                      SelectedItem="{Binding ScheduleVM.Filter}"
                                      Height="48" MinWidth="150"
                                      Style="{StaticResource ModernComboBox}"/>
                        </Grid>

                        <!-- Message -->
                        <TextBlock Grid.Row="1" Text="{Binding ScheduleVM.ScheduleMessage}"
                                   FontSize="16" Foreground="#617589" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- Matches List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScheduleVM.FilteredMatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Padding="16" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="2" Duration="0:0:0.2"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#137FEC" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness" To="1" Duration="0:0:0.2"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E5E7EB" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/> <!-- Number -->
                                                    <ColumnDefinition Width="100"/> <!-- Status -->
                                                    <ColumnDefinition Width="*"/>    <!-- Teams -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Button -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Number -->
                                                <Border Grid.Column="0" Background="#F3F4F6" CornerRadius="6" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MatchNumber, TargetNullValue='#'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#6B7280"/>
                                                </Border>

                                                <!-- Status -->
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="#617589" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                <!-- Teams Center -->
                                                <Grid Grid.Column="2" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Team1}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,24,0" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="Black"/>
                                                    
                                                    <!-- Quick Score -->
                                                    <Border Grid.Column="1" Background="#F9FAFB" CornerRadius="8" Padding="12,4" MinWidth="100">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Team1QuickScore}" FontWeight="Bold" FontSize="18" MinWidth="20" TextAlignment="Center" Foreground="Black"/>
                                                            <TextBlock Text=" : " FontWeight="Bold" FontSize="18" Foreground="#9CA3AF" Margin="4,0"/>
                                                            <TextBlock Text="{Binding Team2QuickScore}" FontWeight="Bold" FontSize="18" MinWidth="20" TextAlignment="Center" Foreground="Black"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Grid.Column="2" Text="{Binding Team2}" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="24,0,0,0" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="Black"/>
                                                </Grid>

                                                <!-- Edit Button -->
                                                <Button Grid.Column="3" Content="Подробнее" 
                                                        Command="{Binding DataContext.OpenMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource AddTeamButtonStyle}" 
                                                        Padding="16,8" Margin="24,0,0,0"
                                                        Background="#E0F2FE" Foreground="#137FEC"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Sidebar -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Статистика" FontWeight="Bold" FontSize="16" Margin="0,0,0,24" Foreground="Black"/>
                            
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Всего матчей" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding ScheduleVM.TotalMatches}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="Black"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Сыграно" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding ScheduleVM.Played}" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <TextBlock Text="Осталось" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding ScheduleVM.NotPlayed}" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <Separator Background="#E5E7EB" Margin="0,0,0,24"/>
                            
                            <TextBlock Text="Фильтр и поиск" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="Black"/>
                            <TextBlock Text="Используйте поиск для фильтрации по названию команды или номеру матча." FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="ResultsTab" Style="{StaticResource TailwindTabItem}">
                <TabItem.Header>
                    <TextBlock Text="Результаты" VerticalAlignment="Center"/>
                </TabItem.Header>

                <Grid Margin="40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Сообщение -->
                        <RowDefinition Height="*"/>
                        <!-- Таблица -->
                        <RowDefinition Height="Auto"/>
                        <!-- Легенда -->
                        <RowDefinition Height="Auto"/>
                        <!-- Кнопка экспорта PNG снизу слева -->
                    </Grid.RowDefinitions>

                    <!-- Сообщение -->
                    <TextBlock Grid.Row="0" Text="{Binding ResultsMessage}"
                   FontSize="16"
                   Foreground="#617589"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>

                    <!-- Таблица — на всё пространство -->
                    <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Заголовок -->
                                <RowDefinition Height="*"/>
                                <!-- Тело -->
                            </Grid.RowDefinitions>

                            <!-- Заголовок таблицы -->
                            <Border Grid.Row="0"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <!-- Rk. -->
                                        <ColumnDefinition Width="280"/>
                                        <!-- Команда -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Шахматная таблица -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- В -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- П -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- ВП -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- ПП -->
                                        <ColumnDefinition Width="70"/>
                                        <!-- Очки -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Rk. -->
                                    <Border Grid.Column="0"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="16,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="№"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Команда -->
                                    <Border Grid.Column="1"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="16,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="Команда"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Left"/>
                                    </Border>

                                    <!-- Номера столбцов шахматной таблицы -->
                                    <ScrollViewer Grid.Column="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding ResultsHeaderNumbers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="60"
                                                Height="70"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                Background="#F9FAFB">
                                                        <TextBlock Text="{Binding}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#617589"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- В -->
                                    <Border Grid.Column="3"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="В"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Выигранные матчи"/>
                                    </Border>

                                    <!-- П -->
                                    <Border Grid.Column="4"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="П"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Проигранные матчи"/>
                                    </Border>

                                    <!-- ВП -->
                                    <Border Grid.Column="5"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="ВП"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Выигранные партии/сеты"/>
                                    </Border>

                                    <!-- ПП -->
                                    <Border Grid.Column="6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="ПП"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Проигранные партии/сеты"/>
                                    </Border>

                                    <!-- Очки -->
                                    <Border Grid.Column="7"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,0"
                                Padding="8,14"
                                Background="#F9FAFB">
                                        <TextBlock Text="Очки"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#617589"
                                       HorizontalAlignment="Center"
                                       ToolTip="Очки по итальянской системе"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Тело таблицы -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultsTable}" Margin="0,5,0,-5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1"
                                    Background="White"
                                    x:Name="RowBorder">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Техническое поражение">
                                                            <Setter Property="Background" Value="#FFF9C4"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Height="70">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <!-- Rk. -->
                                                    <ColumnDefinition Width="280"/>
                                                    <!-- Команда -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Шахматная таблица -->
                                                    <ColumnDefinition Width="60"/>
                                                    <!-- В -->
                                                    <ColumnDefinition Width="60"/>
                                                    <!-- П -->
                                                    <ColumnDefinition Width="60"/>
                                                    <!-- ВП -->
                                                    <ColumnDefinition Width="60"/>
                                                    <!-- ПП -->
                                                    <ColumnDefinition Width="70"/>
                                                    <!-- Очки -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Место -->
                                                <Border Grid.Column="0"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <Border Width="32"
                                                Height="32"
                                                CornerRadius="6"
                                                Background="#F3F4F6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Place}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#111418"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                    </Border>
                                                </Border>

                                                <!-- Название команды -->
                                                <Border Grid.Column="1"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding TeamName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="16,0"/>
                                                </Border>

                                                <!-- Шахматная таблица (ячейки) -->
                                                <ScrollViewer Grid.Column="2"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Hidden">
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="57"
                                                            Height="60"
                                                            Margin="0,0,4,0"
                                                            BorderBrush="#E5E7EB"
                                                            BorderThickness="0,0,1,0"
                                                            Background="{Binding Converter={StaticResource ResultCellBackgroundConverter}}"
                                                            x:Name="CellBorder">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Path Data="M0,0 L60,60 M0,60 L60,0"
                                                                  Stroke="#E5E7EB"
                                                                  StrokeThickness="1.5"
                                                                  Stretch="None"
                                                                  Visibility="Collapsed"
                                                                  x:Name="DiagonalLines">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding}" Value="SELF">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                        <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding Converter={StaticResource ResultCellColorConverter}}"
                                                                       Text="{Binding DisplayText}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                                            <Setter Property="Text" Value=""/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Outcome}" Value="NOT_PLAYED">
                                                                                            <Setter Property="Text" Value="-"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <!-- В -->
                                                <Border Grid.Column="3"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding Wins}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- П -->
                                                <Border Grid.Column="4"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding Losses}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- ВП -->
                                                <Border Grid.Column="5"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding SetsWon}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- ПП -->
                                                <Border Grid.Column="6"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding SetsLost}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111418"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Очки -->
                                                <Border Grid.Column="7"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,0,0"
                                            Background="White">
                                                    <TextBlock Text="{Binding Points}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#137FEC"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- Легенда -->
                    <Border Grid.Row="2"
                Margin="0,16,0,16"
                Padding="16"
                Background="#F9FAFB"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Легенда:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#617589"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Победа (1)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#617589" Opacity="0.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ничья (½)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#F43F5E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Поражение (0)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Кнопка Экспорт (PNG) — снизу слева -->
                    <Button Grid.Row="3"
                            Content="Экспорт (PNG)"
                            Command="{Binding ExportResultsCommand}"
                            Style="{StaticResource AddTeamButtonStyle}"
                            Padding="16,10"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#3B82F6"
                            Foreground="White"/>
                </Grid>
            </TabItem>
            <TabItem Header="Статистика" Style="{StaticResource TailwindTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,32,0,0">
                    <Grid Margin="40,0,40,40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Сводка -->
                            <RowDefinition Height="Auto"/>
                            <!-- Лидер -->
                            <RowDefinition Height="*"/>
                            <!-- Списки -->
                            <RowDefinition Height="Auto"/>
                            <!-- Кнопка экспорта снизу слева -->
                        </Grid.RowDefinitions>

                        <!-- 1. Сводка (сверху) -->
                        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <UniformGrid Rows="1">
                                <!-- Сыграно -->
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Сыграно матчей" FontSize="13" Foreground="#6B7280"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Statistics.PlayedMatches}" FontSize="24" FontWeight="Bold" Foreground="#111418"/>
                                        <TextBlock Text="/" FontSize="24" FontWeight="Bold" Foreground="#9CA3AF" Margin="4,0"/>
                                        <TextBlock Text="{Binding Statistics.TotalMatches}" FontSize="24" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Осталось -->
                                <StackPanel Margin="16,0">
                                    <TextBlock Text="Осталось матчей" FontSize="13" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding Statistics.RemainingMatches}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Пятисетовки -->
                                <StackPanel Margin="16,0">
                                    <TextBlock Text="Количество пятисетовок" FontSize="13" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding Statistics.FiveSetMatches}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Среднее -->
                                <StackPanel Margin="16,0">
                                    <TextBlock Text="Средняя разыгровка мячей" FontSize="13" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding Statistics.AvgGoals}" FontSize="24" FontWeight="Bold" Foreground="#6366F1" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- 2. Лидер турнира (середина) -->
                        <Border Grid.Row="1" CornerRadius="12" Margin="0,0,0,24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#28c08e" Offset="0.0"/>
                                    <!-- начало, самый светлый -->
                                    <GradientStop Color="#27b091" Offset="0.5"/>
                                    <!-- середина, основной акцент -->
                                    <GradientStop Color="#269f94" Offset="1.0"/>
                                    <!-- конец, чуть темнее и "глубже" -->
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="White" Margin="0,0,16,0">
                                        <TextBlock Text="♛" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#059669"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ТЕКУЩИЙ ЛИДЕР" FontSize="12" FontWeight="Bold" Foreground="#D1FAE5"/>
                                        <TextBlock Text="{Binding Statistics.LeaderName}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,24,0" HorizontalAlignment="Right">
                                            <TextBlock Text="Очки" FontSize="12" Foreground="#D1FAE5" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Statistics.LeaderPoints}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="Форма" FontSize="12" Foreground="#D1FAE5" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Statistics.LeaderForm}" FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"
                                           FontFamily="Consolas, Monospace"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- 3. Списки (Топ MVP + Последние матчи) -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Топ MVP -->
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" VerticalAlignment="Top" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Топ-5 MVP" FontSize="16" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>

                                    <ItemsControl ItemsSource="{Binding Statistics.TopMvps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#F3F4F6">
                                                        <TextBlock Text="{Binding PlayerName, StringFormat='{}{0:0}'}" TextTrimming="CharacterEllipsis" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#6B7280" FontSize="12"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0">
                                                        <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold" FontSize="14" Foreground="#111418"/>
                                                        <TextBlock Text="{Binding TeamName}" FontSize="12" Foreground="#6B7280"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="6" Padding="8,4">
                                                        <TextBlock Text="{Binding Count, StringFormat='{}{0} MVP'}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Данные собираются на основе карточек матчей" FontSize="11" Foreground="#9CA3AF" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Последние матчи -->
                            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" VerticalAlignment="Top" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Последние матчи" FontSize="16" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,16"/>

                                    <ItemsControl ItemsSource="{Binding Statistics.LastMatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="12" Background="#F9FAFB" CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding TeamName}" 
                                                       FontSize="14" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="1" Text="{Binding Form}" 
                                                       FontSize="13" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center" 
                                                       FontFamily="Consolas, Monospace" Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Кнопка экспорта — снизу слева -->
                        <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        Margin="0,24,0,0">
                            <Button Content="Экспорт в Excel"
                        Command="{Binding ExportResultsExcelCommand}"
                        Style="{StaticResource AddTeamButtonStyle}"
                        Background="#10B981"
                        Foreground="White"
                        Padding="16,12"
                        FontSize="14"
                        FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Настройки" Style="{StaticResource TailwindTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="40,32,40,40" MaxWidth="900">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. Основная информация -->
                        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Основная информация" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,20"/>

                                <!-- Название турнира -->
                                <TextBlock Text="Название турнира" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CurrentTournament.Name, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="14" Padding="10" Margin="0,0,0,16" 
                                         BorderBrush="#D1D5DB" BorderThickness="1"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Дата начала -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Дата начала" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <DatePicker SelectedDate="{Binding CurrentTournament.StartDate}" 
                                                    FontSize="14" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                    </StackPanel>

                                    <!-- Дата окончания -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Дата окончания" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <DatePicker SelectedDate="{Binding CurrentTournament.EndDate}" 
                                                    FontSize="14" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Место проведения -->
                                <TextBlock Text="Место проведения" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding AvailableCities}" 
                                          SelectedItem="{Binding CurrentTournament.Location}" 
                                          FontSize="14" Padding="10" Margin="0,0,0,0" 
                                          BorderBrush="#D1D5DB" BorderThickness="1" IsEditable="True"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Настройки формата -->
                        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Настройки формата" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Тип турнира -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Тип турнира" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <Border Background="#F9FAFB" CornerRadius="8" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <TextBlock Text="{Binding CurrentTournament.Type}" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Вид спорта -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Вид спорта" FontSize="13" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <Border Background="#F9FAFB" CornerRadius="8" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <TextBlock Text="{Binding CurrentTournament.SportType}" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Очки (динамическая система) -->
                                <TextBlock Text="Система начисления очков" FontSize="13" Foreground="#6B7280" Margin="0,16,0,6"/>
                                <ComboBox ItemsSource="{Binding AvailableScoringSystems}" 
                                          SelectedItem="{Binding SelectedScoringSystem}" 
                                          Style="{DynamicResource ModernComboBox}"
                                          FontSize="14" Padding="10" Margin="0,0,0,12" 
                                          BorderBrush="#D1D5DB" BorderThickness="1"/>

                                <Border Background="#F0F9FF" CornerRadius="8" Padding="16" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Описание правил:" FontSize="12" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ScoringDescription}" FontSize="13" Foreground="#075985" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Пользовательские очки -->
                                <StackPanel Visibility="{Binding IsCustomScoring, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="За победу" FontSize="12" Foreground="#6B7280"/>
                                            <TextBox Text="{Binding WinPoints}" FontSize="14" Padding="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="За ничью" FontSize="12" Foreground="#6B7280"/>
                                            <TextBox Text="{Binding DrawPoints}" FontSize="14" Padding="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="За поражение" FontSize="12" Foreground="#6B7280"/>
                                            <TextBox Text="{Binding LossPoints}" FontSize="14" Padding="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Дополнительные действия -->
                        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Дополнительные действия" FontSize="18" FontWeight="Bold" Foreground="#111418" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal">
                                    <!-- Экспорт результатов -->
                                    <Button Content="Экспорт результатов" 
                                            Command="{Binding ExportResultsCommand}"
                                            Background="#10B981" Foreground="White" 
                                            FontSize="14" FontWeight="SemiBold" 
                                            Padding="16,10" BorderThickness="0" 
                                            Cursor="Hand" Margin="0,0,12,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#059669"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Удалить турнир -->
                                    <Button Content="Удалить турнир" 
                                            Command="{Binding DeleteTournamentCommand}"
                                            Background="#EF4444" Foreground="White" 
                                            FontSize="14" FontWeight="SemiBold" 
                                            Padding="16,10" BorderThickness="0" 
                                            Cursor="Hand">
                                        <!-- Стиль кнопки удаления оставлен прежним -->
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DC2626"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 5. Кнопки сохранения/отмены -->
                        <Border Grid.Row="4" Background="#F9FAFB" CornerRadius="12" Padding="24" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Отмена -->
                                <Button Content="Отмена" 
                                        Command="{Binding CancelSettingsCommand}"
                                        Background="White" Foreground="#374151" 
                                        FontSize="14" FontWeight="SemiBold" 
                                        Padding="20,10" BorderThickness="1" BorderBrush="#D1D5DB"
                                        Cursor="Hand" Margin="0,0,12,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Сохранить -->
                                <Button Content="Сохранить изменения" 
                                        Command="{Binding SaveSettingsCommand}"
                                        Background="#3B82F6" Foreground="White" 
                                        FontSize="14" FontWeight="SemiBold" 
                                        Padding="20,10" BorderThickness="0" 
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>