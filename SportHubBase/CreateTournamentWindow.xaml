<Window x:Class="SportHubBase.CreateTournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление турнира"
        MinWidth="760"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F4F6"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="40,30" 
                    MaxWidth="560" 
                    HorizontalAlignment="Center">

                <StackPanel>

                    <!-- Заголовок -->
                    <TextBlock Text="Добавление турнира" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Margin="0,0,0,8"/>
                    <TextBlock Text="* - поля, обязательные для заполнения" 
                               Foreground="Red" 
                               FontSize="13" 
                               Margin="0,0,0,24"/>

                    <!-- Название -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Название *" FontWeight="Bold" FontSize="14"/>
                        <TextBox x:Name="NameTextBox" Height="42" Margin="0,8,0,0" Padding="10,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Статус + Вид спорта -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Статус *" FontWeight="Bold" FontSize="14"/>
                            <ComboBox x:Name="StatusComboBox" Height="36" Margin="0,8,0,0" SelectedIndex="0" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem>Активный</ComboBoxItem>
                                <ComboBoxItem>Неактивный</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Вид спорта *" FontWeight="Bold" FontSize="14"/>
                            <ComboBox x:Name="SportTypeComboBox" Height="36" Margin="0,8,0,0" SelectedIndex="1" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem>Другое</ComboBoxItem>
                                <ComboBoxItem>Волейбол</ComboBoxItem>
                                <ComboBoxItem>Баскетбол</ComboBoxItem>
                                <ComboBoxItem>Футбол</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Тип турнира -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Тип *" FontWeight="Bold" FontSize="14"/>
                        <WrapPanel x:Name="TournamentTypeRadioPanel" Margin="0,12,0,12" >
                            <RadioButton Content="Круговой"     IsChecked="True"  GroupName="TournamentType" Margin="0,0,32,8" Checked="RadioButton_Checked"/>
                            <RadioButton Content="Олимпийский"                   GroupName="TournamentType" Margin="0,0,32,8" Checked="RadioButton_Checked"/>
                            <RadioButton Content="Швейцарский"                   GroupName="TournamentType" Margin="0,0,32,8" Checked="RadioButton_Checked" Visibility="Hidden"/>
                            <RadioButton Content="Многоэтапный"                  GroupName="TournamentType" Checked="RadioButton_Checked" Visibility="Hidden"/>
                        </WrapPanel>

                        <!-- Динамическое описание -->
                        <ContentControl x:Name="TournamentTypeDescriptionPlaceholder"/>

                        <!-- Количество туров (только для Швейцарской) -->
                        <StackPanel x:Name="TotalRoundsStackPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="Количество туров *" FontWeight="Bold" FontSize="14"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TotalRoundsTextBox" Height="36" Text="{Binding TotalRounds, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Рекомендуемое значение" 
                                        Command="{Binding ApplyRecommendedRoundsCommand}"
                                        Style="{StaticResource DefaultModernButton}"
                                        Margin="12,0,0,0" Padding="16,0" Height="36"/>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Для " VerticalAlignment="Center" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding ExpectedTeams, UpdateSourceTrigger=PropertyChanged}" Width="40" Height="24" Margin="4,0" TextAlignment="Center"/>
                                    <TextBlock Text=" команд" VerticalAlignment="Center" Foreground="#6B7280"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding RecommendedRoundsHint}" Foreground="#137FEC" FontSize="12" Margin="0,4,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Описание -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Описание" FontWeight="Bold" FontSize="14"/>
                        <TextBox x:Name="DescriptionTextBox" Height="80" Margin="0,8,0,0" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Город -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Город" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       VerticalAlignment="Center"
                                       Grid.Column="0"/>

                            <ComboBox x:Name="CityComboBox" Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      HorizontalAlignment="Right"
                                      Width="220"
                                      Height="36"
                                      VerticalAlignment="Center"
                                      IsEditable="True"
                                      Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding FilteredCities}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Контакты организатора -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Контакты организатора (телефон, email, соцсети)" FontWeight="Bold" FontSize="14"/>
                        <TextBox x:Name="ContactsTextBox" Height="38" Margin="0,8,0,0" Padding="10,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Дата начала -->
                    <StackPanel Width="250" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <TextBlock Text="Дата начала *" FontWeight="Bold" FontSize="14"/>
                        <DatePicker x:Name="StartDatePicker" Height="36" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- === БЛОК: РАЗМЕЩЕНИЕ НА УДАЛЁННОМ СЕРВЕРЕ === -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,28">
                        <StackPanel>
                            <CheckBox x:Name="IsRemoteCheckBox"
                                      Content="🌐 Опубликовать турнир на удалённом сервере (MS SQL Server)"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="#0F172A"
                                      Checked="IsRemoteCheckBox_Changed"
                                      Unchecked="IsRemoteCheckBox_Changed"/>
                            <TextBlock Text="По умолчанию турнир хранится локально на вашем ПК и не требует пароля. Если включить публикацию на сервере, другие пользователи смогут подключить его для просмотра, а редактирование будет защищено логином и паролем организатора."
                                       Foreground="#64748B"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="24,6,0,0"/>

                            <StackPanel x:Name="RemoteSettingsPanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Адрес SQL Server *" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                    <TextBox x:Name="ServerAddressTextBox" Text="localhost" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Например: localhost, .\SQLEXPRESS или IP-адрес сервера" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Логин организатора *" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                        <TextBox x:Name="OrganizerLoginTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Пароль организатора *" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                        <PasswordBox x:Name="OrganizerPasswordBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Создать турнир"
                                x:Name="CreateTournament"
                                Style="{StaticResource DefaultModernButton}"
                                Click="CreateTournament_Click"
                                FontWeight="Medium" 
                                Padding="28,12" 
                                FontSize="14" 
                                Margin="0,0,16,0"/>
                        <Button Content="Отмена" 
                                Style="{StaticResource DefaultModernButton}"
                                Click="CancelButton_Click"
                                Padding="24,12"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>