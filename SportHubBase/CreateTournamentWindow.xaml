<Window x:Class="SportHubBase.CreateTournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление турнира"
        MinWidth="760"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F4F6"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="40,30" 
                    MaxWidth="540" 
                    HorizontalAlignment="Center">

                <StackPanel>

                    <!-- Заголовок -->
                    <TextBlock Text="Добавление турнира" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Margin="0,0,0,8"/>
                    <TextBlock Text="* - поля, обязательные для заполнения" 
                               Foreground="Red" 
                               FontSize="13" 
                               Margin="0,0,0,24"/>

                    <!-- === ДИНАМИЧЕСКИЙ БЛОК: Администраторы === -->
                    <ContentControl x:Name="AdministratorsPlaceholder"/>

                    <!-- Название -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Название *" FontWeight="Bold" FontSize="14"/>
                        <TextBox x:Name="NameTextBox" Height="42" Margin="0,8,0,0"/>
                    </StackPanel>


                    <!-- Статус + Вид спорта -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Статус *" FontWeight="Bold" FontSize="14"/>
                            <ComboBox x:Name="StatusComboBox" Height="36" Margin="0,8,0,0" SelectedIndex="0" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem>Активный</ComboBoxItem>
                                <ComboBoxItem>Неактивный</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Вид спорта *" FontWeight="Bold" FontSize="14"/>
                            <ComboBox x:Name="SportTypeComboBox" Height="36" Margin="0,8,0,0" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem>Другое</ComboBoxItem>
                                <ComboBoxItem>Волейбол</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Тип турнира -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Тип *" FontWeight="Bold" FontSize="14"/>
                        <WrapPanel x:Name="TournamentTypeRadioPanel" Margin="0,12,0,12" >
                            <RadioButton Content="Круговой"     IsChecked="True"  GroupName="TournamentType" Margin="0,0,32,8" Checked="RadioButton_Checked"/>
                            <RadioButton Content="Олимпийский"                   GroupName="TournamentType" Margin="0,0,32,8" Checked="RadioButton_Checked"/>
                            <RadioButton Content="Швейцарский"                   GroupName="TournamentType" Margin="0,0,32,8" Checked="RadioButton_Checked"/>
                            <RadioButton Content="Многоэтапный"                  GroupName="TournamentType" Checked="RadioButton_Checked"/>
                        </WrapPanel>

                        <!-- Динамическое описание -->
                        <ContentControl x:Name="TournamentTypeDescriptionPlaceholder"/>

                        <!-- Количество туров (только для Швейцарской) -->
                        <StackPanel x:Name="TotalRoundsStackPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="Количество туров *" FontWeight="Bold" FontSize="14"/>
                            <TextBox x:Name="TotalRoundsTextBox" Height="36" Margin="0,8,0,0" Text="7" Width="100" HorizontalAlignment="Left" />
                            <TextBlock Text="По умолчанию 7 туров. Для 24-32 команд рекомендуется 8-9 туров." Foreground="#6B7280" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Режимы -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Режим редактирования игр *" FontWeight="Bold" FontSize="14"/>
                            <ComboBox x:Name="EditModeComboBox" Height="36" Margin="0,8,0,0" SelectedIndex="0" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem>Только администраторы турнира</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Режим доступа *" FontWeight="Bold" FontSize="14"/>
                            <ComboBox x:Name="AccessModeComboBox" Height="36" Margin="0,8,0,0" SelectedIndex="0" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem>Доступно всем</ComboBoxItem>
                                <ComboBoxItem>Приватный</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Без счёта -->
                    <StackPanel Margin="0,0,0,20">
                        <CheckBox x:Name="NoScoreCheckBox" Content="Без счета" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Для турниров, где важен только факт победы или поражения"
                                   Foreground="#6B7280" FontSize="13" Margin="24,0,0,0"/>
                    </StackPanel>

                    <!-- Описание -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Описание" FontWeight="Bold" FontSize="14"/>
                        <TextBox x:Name="DescriptionTextBox" Height="100" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Город -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Город" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       VerticalAlignment="Center"
                                       Grid.Column="0"/>

                            <ComboBox x:Name="CityComboBox" Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      HorizontalAlignment="Right"
                                      Width="200"
                                      Height="36"
                                      VerticalAlignment="Center"
                                      IsEditable="True"
                                      Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding FilteredCities}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Контакты -->
                    <StackPanel Margin="0,0,0,20">
                        <CheckBox x:Name="AddContactsCheckBox" Content="Добавить контактные данные" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Ваши контактные данные (Email, Телефон) из профиля будут видны всем"
                                   Foreground="#6B7280" FontSize="13" Margin="24,0,0,0"/>
                    </StackPanel>

                    <!-- Дата начала -->
                    <StackPanel Width="250" HorizontalAlignment="Left" Margin="0,0,0,30">
                        <TextBlock Text="Дата начала *" FontWeight="Bold" FontSize="14"/>
                        <DatePicker x:Name="StartDatePicker" Height="36" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Создать турнир"
                                x:Name="CreateTournament"
                                Style="{StaticResource DefaultModernButton}"
                                Click="CreateTournament_Click"
                                FontWeight="Medium" 
                                Padding="28,12" 
                                FontSize="14" 
                                Margin="0,0,16,0"/>
                        <Button Content="Отмена" 
                                Style="{StaticResource DefaultModernButton}"
                                Padding="24,12"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>