<Window x:Class="SportHubBase.View.ConnectRemoteTournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить турнир с сервера"
        Width="980" Height="680" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2F1"/>
                    <Setter Property="Foreground" Value="#134E4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock" x:Key="TableText">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Добавить турнир с сервера" FontSize="26"
                       FontWeight="SemiBold" Foreground="#1E293B"/>
            <TextBlock Text="Найдите турнир и добавьте его в список на главном экране."
                       FontSize="14" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Адрес сервера" FontSize="14" FontWeight="SemiBold"
                           Foreground="#334155" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerAddressTextBox" Height="42" Padding="12,0"
                             TextAlignment="Left" HorizontalContentAlignment="Left" FontWeight="Normal"
                             VerticalContentAlignment="Center" FontSize="14" Text="localhost"
                             BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,12,0"
                             AutomationProperties.Name="Адрес сервера"
                             TextChanged="ServerAddressTextBox_TextChanged"/>
                    <Button x:Name="SearchServerButton" Grid.Column="1" Content="Найти турниры"
                            Style="{StaticResource DefaultModernButton}" Height="42" Padding="20,0"
                            Click="SearchServerButton_Click"/>
                </Grid>
                <TextBlock Text="Поддерживается SQL Server с базой SportHub. Адрес и параметры доступа уточните у администратора."
                           FontSize="12" Foreground="#64748B" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Доступные турниры" FontSize="16" FontWeight="SemiBold"
                           Foreground="#1E293B" Margin="4,0,4,8"/>
                <TextBlock x:Name="StatusTextBlock" Grid.Row="1"
                           Text="Введите адрес сервера и нажмите «Найти турниры»."
                           FontSize="13" Foreground="#64748B" Margin="4,0,4,14" TextWrapping="Wrap"/>
                <DataGrid x:Name="RemoteTournamentsGrid" Grid.Row="2"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0" Background="White"
                          RowHeight="42" FontSize="13" CanUserAddRows="False" CanUserReorderColumns="False"
                          SelectionChanged="RemoteTournamentsGrid_SelectionChanged"
                          MouseDoubleClick="RemoteTournamentsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Турнир" Binding="{Binding Name}" Width="2*" MinWidth="130" ElementStyle="{StaticResource TableText}"/>
                        <DataGridTextColumn Header="Вид спорта" Binding="{Binding SportType}" Width="*" MinWidth="100" ElementStyle="{StaticResource TableText}"/>
                        <DataGridTextColumn Header="Формат" Binding="{Binding Type}" Width="*" MinWidth="100" ElementStyle="{StaticResource TableText}"/>
                        <DataGridTextColumn Header="Команд" Binding="{Binding Teams.Count}" Width="76"/>
                        <DataGridTextColumn Header="Организатор" Binding="{Binding OwnerName}" Width="*" MinWidth="110" ElementStyle="{StaticResource TableText}"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Background="White">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=RemoteTournamentsGrid}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                        <TextBlock Text="Список турниров пуст" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#475569" TextAlignment="Center"/>
                        <TextBlock Text="Здесь появятся турниры, найденные на указанном сервере."
                                   Foreground="#64748B" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Без сети доступен просмотр последней загруженной копии."
                       Foreground="#64748B" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,24,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource DefaultModernButton}"
                        Height="42" Padding="20,0" Margin="0,0,12,0" Click="CancelButton_Click"/>
                <Button x:Name="ConnectButton" Content="Добавить турнир" IsEnabled="False"
                        Style="{StaticResource ModernAddButton}" Height="42" Padding="24,0"
                        Click="ConnectButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
