<UserControl x:Class="SportHubBase.View.TournamentBracketControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:SportHubBase.Models"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <Canvas x:Name="MainCanvas"
                MinWidth="1200"
                MinHeight="600">

            <!-- Линии — рисуем ДО карточек, чтобы карточки были поверх -->
            <ItemsControl ItemsSource="{Binding Connections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding StartX}" Y1="{Binding StartY}"
                              X2="{Binding EndX}"   Y2="{Binding EndY}"
                              Stroke="#CBD5E1" StrokeThickness="2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Карточки матчей -->
            <ItemsControl ItemsSource="{Binding AllMatches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding XPosition}"/>
                        <Setter Property="Canvas.Top"  Value="{Binding YPosition}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:BracketMatch}">
                        <Border Width="220" Height="78"
                                Background="White"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,6,0,6">
                            <!-- воздух между карточками -->

                            <!-- Тень ТОЛЬКО СНИЗУ, слабая -->
                            <Border.Effect>
                                <DropShadowEffect Color="#000000"
                                                  Direction="270"    
                                                  ShadowDepth="3"
                                                  BlurRadius="10"
                                                  Opacity="0.08"/>
                                    <!-- очень лёгкая -->
                            </Border.Effect>

                            <Grid>
                                <!-- Челка сверху (серый островок) -->
                                <Border Height="28"
                                        Background="#f8f9fa"
                                        CornerRadius="8,8,0,0"
                                        VerticalAlignment="Top"/>

                                <!-- Основное содержимое (ниже челки) -->
                                <Grid Margin="12,30,12,8">
                                    <!-- 28 челки + 2 воздуха = 30 сверху -->
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Команда 1 + счёт -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayTeam1}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="#1E293B"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Score1, TargetNullValue='–', FallbackValue='–'}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#1E293B"  
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayTeam2}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="#1E293B"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Score2, TargetNullValue='–', FallbackValue='–'}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#1E293B"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Canvas>
    </ScrollViewer>
</UserControl>