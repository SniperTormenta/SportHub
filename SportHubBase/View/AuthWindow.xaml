<Window x:Class="SportHubBase.View.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ViewTitle}" 
        Height="650" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Inter, Segoe UI"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка закрытия -->
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="15" Width="30" Height="30" Background="Transparent" BorderThickness="0"
                    Foreground="#94A3B8" FontSize="16" Cursor="Hand" Click="Close_Click"/>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="40,40,40,20">
                <Border Width="56" Height="56" Background="#EFF6FF" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="🏆" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding ViewTitle}" FontSize="24" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                <TextBlock Text="Версия 1.0" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Форма -->
            <ScrollViewer Grid.Row="1" Margin="40,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Username -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8">
                            <Run Text="Имя пользователя (Логин)"/>
                            <Run Text="*" Foreground="#EF4444"/>
                        </TextBlock>
                        <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource DefaultModernTextBox}" Tag="Введите логин..."/>
                        <TextBlock Text="4-32 символа: a-z, 0-9, _, -, ." FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"
                                   Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,16" Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8">
                            <Run Text="Email"/>
                            <Run Text="*" Foreground="#EF4444"/>
                        </TextBlock>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource DefaultModernTextBox}" Tag="example@mail.com"/>
                    </StackPanel>

                    <!-- FirstName -->
                    <StackPanel Margin="0,0,0,16" Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8">
                            <Run Text="Имя"/>
                            <Run Text="*" Foreground="#EF4444"/>
                        </TextBlock>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource DefaultModernTextBox}" Tag="Ваше имя..."/>
                    </StackPanel>

                    <!-- City (Optional) -->
                    <StackPanel Margin="0,0,0,16" Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Город" FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource DefaultModernTextBox}" Tag="Ваш город (необязательно)"/>
                    </StackPanel>

                    <!-- Phone (Optional) -->
                    <StackPanel Margin="0,0,0,16" Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Телефон" FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource DefaultModernTextBox}" Tag="+7 (999) 000-00-00"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8">
                            <Run Text="Пароль"/>
                            <Run Text="*" Foreground="#EF4444"/>
                        </TextBlock>
                        <Border CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Height="48" Background="White">
                            <PasswordBox x:Name="PasswordInput" BorderThickness="0" Background="Transparent" 
                                         Padding="14,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </Border>
                        <TextBlock Text="Мин. 8 символов, заглавная, строчная и цифра" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"
                                   Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Confirm Password -->
                    <StackPanel Margin="0,0,0,16" Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8">
                            <Run Text="Подтверждение пароля"/>
                            <Run Text="*" Foreground="#EF4444"/>
                        </TextBlock>
                        <Border CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Height="48" Background="White">
                            <PasswordBox x:Name="ConfirmPasswordInput" BorderThickness="0" Background="Transparent" 
                                         Padding="14,0" VerticalContentAlignment="Center" FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="* - обязательные поля для заполнения" FontSize="12" Foreground="#94A3B8" 
                               FontStyle="Italic" Margin="0,0,0,10"
                               Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>

                    <!-- Ошибка -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="13" 
                               TextWrapping="Wrap" Margin="0,0,0,12" MinHeight="20" TextAlignment="Center"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>

                    <!-- Кнопка действия -->
                    <Button Height="48" FontWeight="Bold" FontSize="15" Click="AuthAction_Click" Margin="0,0,0,20">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SilentModernButton}">
                                <Setter Property="Content" Value="{Binding ActionName}"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Футер -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,16,16" Padding="20" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding IsLoginMode, ConverterParameter=Inverse, Converter={StaticResource BoolToVis}, StringFormat='{}Нет аккаунта? ', FallbackValue='Нет аккаунта? '}" 
                               Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}"
                               Foreground="#64748B" FontSize="14"/>
                    <TextBlock Text="Уже есть аккаунт? " 
                               Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"
                               Foreground="#64748B" FontSize="14"/>
                    
                    <TextBlock Text="{Binding IsLoginMode, ConverterParameter=Inverse, Converter={StaticResource BoolToVis}, StringFormat='{}Регистрация', FallbackValue='Регистрация'}" 
                               Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}"
                               Foreground="#2563EB" FontWeight="SemiBold" Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleModeCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <TextBlock Text="Войти" 
                               Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"
                               Foreground="#2563EB" FontWeight="SemiBold" Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleModeCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>