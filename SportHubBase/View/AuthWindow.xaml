<Window x:Class="SportHubBase.View.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SportHubBase.Converters"
        Title="Вход — Tournament Manager"
        Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F8"
        FontFamily="Inter, Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Цвета -->
        <SolidColorBrush x:Key="Primary" Color="#137FEC"/>
        <SolidColorBrush x:Key="BgLight" Color="#F6F7F8"/>
        <SolidColorBrush x:Key="CardBg" Color="White"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="InputBg" Color="White"/>

        <!-- Радиусы -->
        <CornerRadius x:Key="RadiusLg">8</CornerRadius>
        <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    </Window.Resources>

    <Border Background="{StaticResource BgLight}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Главная карточка -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBg}"
                    CornerRadius="{StaticResource RadiusXl}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    MaxWidth="480"
                    VerticalAlignment="Center"
                    Margin="0,0,0,32">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Хедер -->
                    <StackPanel Grid.Row="0" Margin="0,40,0,24" HorizontalAlignment="Center">
                        <Border Width="48" Height="48"
                                Background="#EFF6FF" CornerRadius="12"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🏆" FontSize="32"
                                       Foreground="{StaticResource Primary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Заголовки Логина -->
                        <TextBlock Text="Авторизация"
                                   FontSize="24" Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="Войдите, чтобы управлять турнирами"
                                   FontSize="14" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}"/>
                        
                        <!-- Заголовки Регистрации -->
                        <TextBlock Text="Регистрация"
                                   FontSize="24" Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="Создайте аккаунт для начала работы"
                                   FontSize="14" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Форма Логин -->
                    <StackPanel Grid.Row="1" Margin="32,0,32,32" VerticalAlignment="Center"
                                Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}">
                        <!-- Email -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Email" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                            <Border CornerRadius="6" BorderBrush="{StaticResource InputBorder}"
                                    BorderThickness="1" Background="{StaticResource InputBg}">
                                <Grid>
                                    <TextBox Padding="12,0" FontSize="14" BorderThickness="0"
                                             Background="Transparent" VerticalContentAlignment="Center"
                                             Margin="0,0,32,0"/>
                                    <!-- placeholder через Attached Prop потом -->
                                    <TextBlock Text="✉" FontSize="20" Foreground="#9CA3AF"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Margin="0,0,0,20">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Пароль" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Grid>
                            <Border CornerRadius="6" BorderBrush="{StaticResource InputBorder}"
                                    BorderThickness="1" Background="{StaticResource InputBg}">
                                <Grid>
                                    <PasswordBox Padding="12,0" FontSize="14" BorderThickness="0"
                                                 Background="Transparent" VerticalContentAlignment="Center"
                                                 Margin="0,0,32,0"/>
                                    <TextBlock Text="👁" FontSize="20" Foreground="#9CA3AF"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,12,0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <CheckBox Content="Не выходить из аккаунта" 
                                  Margin="0,12,0,20"
                                  FontSize="14"
                                  Foreground="{StaticResource TextPrimary}"
                                  IsChecked="{Binding RememberMe, Mode=TwoWay}"/>
                        <!-- Кнопка -->
                        <Button Content="Войти" Height="48" Background="{StaticResource Primary}"
                                Foreground="White" FontWeight="Medium" FontSize="14"
                                BorderThickness="0"
                                Style="{StaticResource  SilentModernButton}" />
                    </StackPanel>
                    
                    <!-- Форма Регистрации (разметка отложена, добавлен каркас) -->
                    <StackPanel Grid.Row="1" Margin="32,0,32,32" VerticalAlignment="Center"
                                Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Здесь будет разметка формы регистрации (Email, Password, ConfirmPassword, DisplayName)..." 
                                   Foreground="{StaticResource TextSecondary}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Футер карточки -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderThickness="0,1,0,0"
                            BorderBrush="#E2E8F0" Padding="32,16">
                        <Grid>
                            <!-- Логин: переход на Регистрацию -->
                            <TextBlock HorizontalAlignment="Center" FontSize="14"
                                       Foreground="{StaticResource TextSecondary}"
                                       Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}"
                                       Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SwitchToRegisterCommand}"/>
                                </TextBlock.InputBindings>
                                Нет аккаунта? <Run Foreground="{StaticResource Primary}" Text="Зарегистрироваться"/>
                            </TextBlock>
                            
                            <!-- Регистрация: переход на Логин -->
                            <TextBlock HorizontalAlignment="Center" FontSize="14"
                                       Foreground="{StaticResource TextSecondary}"
                                       Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"
                                       Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SwitchToLoginCommand}"/>
                                </TextBlock.InputBindings>
                                Уже есть аккаунт? <Run Foreground="{StaticResource Primary}" Text="Войти"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>