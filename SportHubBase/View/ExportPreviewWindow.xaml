<Window x:Class="SportHubBase.View.ExportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SportHubBase.Converters"
        xmlns:models="clr-namespace:SportHubBase.Models"
        Title="Предпросмотр экспорта таблицы результатов"
        Height="860" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        FontFamily="Inter, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:SelfCellImageConverter x:Key="SelfCellImageConverter"/>
        <converters:CardBackgroundImageConverter x:Key="CardBackgroundImageConverter"/>

        <!-- Шаблон строки результатов в тёмно-синем стиле ВОЛЕЙБОЛ АЛВ -->
        <DataTemplate x:Key="ResultsRowTemplate">
            <Border BorderBrush="#3338BDF8"
                    BorderThickness="0,0,0,1"
                    Background="#9906142E">
                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <!-- Место -->
                        <ColumnDefinition Width="260"/>
                        <!-- Команда -->
                        <ColumnDefinition Width="*"/>
                        <!-- Шахматная таблица -->
                        <ColumnDefinition Width="58"/>
                        <!-- В -->
                        <ColumnDefinition Width="58"/>
                        <!-- П -->
                        <ColumnDefinition Width="58"/>
                        <!-- ВП -->
                        <ColumnDefinition Width="58"/>
                        <!-- ПП -->
                        <ColumnDefinition Width="68"/>
                        <!-- Очки -->
                    </Grid.ColumnDefinitions>

                    <!-- Место -->
                    <Border Grid.Column="0"
                            BorderBrush="#2638BDF8"
                            BorderThickness="0,0,1,0">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="8"
                                Background="#1E3A8A"
                                BorderBrush="#60A5FA"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Place}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Border>

                    <!-- Название команды -->
                    <Border Grid.Column="1"
                            BorderBrush="#2638BDF8"
                            BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding TeamName}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="16,0"/>
                    </Border>

                    <!-- Шахматная таблица (ячейки) -->
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="60"
                                        Height="64"
                                        BorderBrush="#2638BDF8"
                                        BorderThickness="0,0,1,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="Background" Value="#CC030917"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="WIN">
                                                    <Setter Property="Background" Value="#2610B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="LOSS">
                                                    <Setter Property="Background" Value="#26F43F5E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Path Data="M0,0 L60,64 M0,64 L60,0"
                                              Stroke="#3364748B"
                                              StrokeThickness="1.2"
                                              Stretch="Fill"
                                              Visibility="Collapsed">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelf}" Value="True"/>
                                                                <Condition Binding="{Binding HasSelfImage}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Image Source="{Binding SelfImageData, Converter={StaticResource SelfCellImageConverter}}"
                                               Width="36" Height="36"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasSelfImage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Text="{Binding DisplayText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                            <Setter Property="Text" Value=""/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="NOT_PLAYED">
                                                            <Setter Property="Text" Value="–"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="WIN">
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="LOSS">
                                                            <Setter Property="Foreground" Value="#FDA4AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- В (победы) -->
                    <Border Grid.Column="3"
                            BorderBrush="#2638BDF8"
                            BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding Wins}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#34D399"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- П (поражения) -->
                    <Border Grid.Column="4"
                            BorderBrush="#2638BDF8"
                            BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding Losses}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- ВП (выигранные партии) -->
                    <Border Grid.Column="5"
                            BorderBrush="#2638BDF8"
                            BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding WonGames}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#E2E8F0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- ПП (проигранные партии) -->
                    <Border Grid.Column="6"
                            BorderBrush="#2638BDF8"
                            BorderThickness="0,0,1,0">
                        <TextBlock Text="{Binding LostGames}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Очки -->
                    <Border Grid.Column="7"
                            Background="#330284C7">
                        <TextBlock Text="{Binding Points}"
                                   FontSize="17"
                                   FontWeight="Black"
                                   Foreground="#38BDF8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="24"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header окна -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TournamentName}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Border Background="#1E293B" CornerRadius="6" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TableTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="34" Height="34"
                            Background="#1E293B"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CloseCommand}">
                        <TextBlock Text="×"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Preview body -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Border x:Name="PreviewRoot"
                            MinWidth="1040"
                            Background="#040B1A"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Фоновое изображение (пользовательское или стандартное АЛВ) -->
                            <Image Source="{Binding CardBackgroundData, Converter={StaticResource CardBackgroundImageConverter}}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Тёмно-синяя вуаль для контрастности таблицы -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#CC040C1E" Offset="0.0"/>
                                        <GradientStop Color="#B2061530" Offset="0.5"/>
                                        <GradientStop Color="#E0030917" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid Margin="44,36,44,30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Шапка карточки турнира в стиле АЛВ -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                                    <TextBlock Text="М О И   Т У Р Н И Р Ы"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#CBD5E1"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding TournamentName}"
                                               FontSize="36"
                                               FontWeight="Black"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,6,0,10"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Width="110" Height="1.5" Background="#8094A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SubtitleText}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="#38BDF8"
                                                   Margin="16,0"
                                                   VerticalAlignment="Center"/>
                                        <Border Width="110" Height="1.5" Background="#8094A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Таблица результатов -->
                                <Border Grid.Row="1"
                                        BorderBrush="#6638BDF8"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Background="#B2050F24"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Заголовок таблицы -->
                                        <Border Grid.Row="0"
                                                BorderBrush="#4D38BDF8"
                                                BorderThickness="0,0,0,1.5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#E60369A1" Offset="0.0"/>
                                                    <GradientStop Color="#E6075985" Offset="0.5"/>
                                                    <GradientStop Color="#E60C4A6E" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid Height="54">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="260"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="68"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" BorderBrush="#337DD3FC" BorderThickness="0,0,1,0">
                                                    <TextBlock Text="№" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <Border Grid.Column="1" BorderBrush="#337DD3FC" BorderThickness="0,0,1,0" Padding="16,0">
                                                    <TextBlock Text="КОМАНДА" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </Border>

                                                <ItemsControl Grid.Column="2" ItemsSource="{Binding HeaderNumbers}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="60" Height="54" BorderBrush="#337DD3FC" BorderThickness="0,0,1,0">
                                                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#E0F2FE"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Grid.Column="3" BorderBrush="#337DD3FC" BorderThickness="0,0,1,0">
                                                    <TextBlock Text="В" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <Border Grid.Column="4" BorderBrush="#337DD3FC" BorderThickness="0,0,1,0">
                                                    <TextBlock Text="П" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <Border Grid.Column="5" BorderBrush="#337DD3FC" BorderThickness="0,0,1,0">
                                                    <TextBlock Text="ВП" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <Border Grid.Column="6" BorderBrush="#337DD3FC" BorderThickness="0,0,1,0">
                                                    <TextBlock Text="ПП" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <Border Grid.Column="7">
                                                    <TextBlock Text="ОЧКИ" FontSize="13" FontWeight="Black" Foreground="#7DD3FC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Тело таблицы -->
                                        <ItemsControl Grid.Row="1"
                                                      ItemsSource="{Binding Rows}"
                                                      ItemTemplate="{StaticResource ResultsRowTemplate}"/>
                                    </Grid>
                                </Border>

                                <!-- Легенда -->
                                <Border Grid.Row="2"
                                        Margin="0,16,0,20"
                                        Padding="16,10"
                                        Background="#B2051024"
                                        CornerRadius="10"
                                        BorderBrush="#3338BDF8"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Обозначения:" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                            <Border Width="10" Height="10" CornerRadius="2" Background="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Победа" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                            <Border Width="10" Height="10" CornerRadius="2" Background="#FDA4AF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Поражение" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="В — победы, П — поражения, ВП/ПП — партии" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Фирменная подпись «ВОЛЕЙБОЛ АЛВ» с эмблемой мяча -->
                                <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="96" Height="1.5" Background="#CCFFFFFF" VerticalAlignment="Center"/>
                                        <Grid Width="32" Height="32" Margin="16,0">
                                            <Ellipse Stroke="White" StrokeThickness="2" Fill="#1AFFFFFF"/>
                                            <Path Data="M 4,16 Q 16,8 28,16 M 8,5 Q 16,16 8,27 M 24,5 Q 16,16 24,27 M 6,9 Q 16,13 26,9"
                                                  Stroke="White"
                                                  StrokeThickness="1.5"
                                                  Stretch="None"/>
                                        </Grid>
                                        <Border Width="96" Height="1.5" Background="#CCFFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="В О Л Е Й Б О Л   А Л В"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="🖼 Загрузить свой фон"
                            Command="{Binding SelectBackgroundCommand}"
                            Padding="16,10"
                            Background="#1E293B"
                            Foreground="#38BDF8"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                    <Button Grid.Column="1"
                            Content="↺ Стандартный фон АЛВ"
                            Command="{Binding ResetBackgroundCommand}"
                            Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="14,10"
                            Margin="10,0,0,0"
                            Background="#1E293B"
                            Foreground="#CBD5E1"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                    <Button Grid.Column="3"
                            x:Name="CancelButton"
                            Content="Отмена"
                            Padding="20,10"
                            Background="Transparent"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            Foreground="#E2E8F0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Command="{Binding CloseCommand}"/>

                    <Button Grid.Column="5"
                            x:Name="SaveButton"
                            Content="💾 Сохранить как изображение"
                            Padding="22,10"
                            Background="#0284C7"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="SaveButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
