<Window x:Class="SportHubBase.View.ExportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SportHubBase.Converters"
        xmlns:models="clr-namespace:SportHubBase.Models"
        Title="Предпросмотр экспорта"
        Height="800" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Шаблон строки результатов для экспорта -->
        <DataTemplate x:Key="ResultsRowTemplate">
            <Border BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Background="White">
                <Grid Height="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <!-- Rk. -->
                        <ColumnDefinition Width="280"/>
                        <!-- Команда -->
                        <ColumnDefinition Width="*"/>
                        <!-- Шахматная таблица -->
                        <ColumnDefinition Width="60"/>
                        <!-- В -->
                        <ColumnDefinition Width="60"/>
                        <!-- П -->
                        <ColumnDefinition Width="60"/>
                        <!-- ВП -->
                        <ColumnDefinition Width="60"/>
                        <!-- ПП -->
                        <ColumnDefinition Width="70"/>
                        <!-- Очки -->
                    </Grid.ColumnDefinitions>

                    <!-- Место -->
                    <Border Grid.Column="0"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,1,0"
                            Background="White">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="6"
                                Background="#F3F4F6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Place}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#111418"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Border>

                    <!-- Название команды -->
                    <Border Grid.Column="1"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,1,0"
                            Background="White">
                        <TextBlock Text="{Binding TeamName}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111418"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="16,0"/>
                    </Border>

                    <!-- Шахматная таблица (ячейки) -->
                    <ScrollViewer Grid.Column="2"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="60"
                                            Height="60"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            Background="{Binding Converter={StaticResource ResultCellBackgroundConverter}}">
                                        <Grid>
                                            <Path Data="M0,0 L60,60 M0,60 L60,0"
                                                  Stroke="#E5E7EB"
                                                  StrokeThickness="1.5"
                                                  Stretch="None"
                                                  Visibility="Collapsed"
                                                  x:Name="DiagonalLines">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="SELF">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="16"
           FontWeight="SemiBold"
           Foreground="{Binding Converter={StaticResource ResultCellColorConverter}}"
           Text="{Binding DisplayText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Outcome}" Value="NOT_PLAYED">
                                                                <Setter Property="Text" Value="-"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- В (победы) -->
                    <Border Grid.Column="3"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,1,0"
                            Background="White">
                        <TextBlock Text="{Binding Wins}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111418"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- П (поражения) -->
                    <Border Grid.Column="4"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,1,0"
                            Background="White">
                        <TextBlock Text="{Binding Losses}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111418"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- ВП (выигранные партии) -->
                    <Border Grid.Column="5"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,1,0"
                            Background="White">
                        <TextBlock Text="{Binding WonGames}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111418"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- ПП (проигранные партии) -->
                    <Border Grid.Column="6"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,1,0"
                            Background="White">
                        <TextBlock Text="{Binding LostGames}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111418"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Очки -->
                    <Border Grid.Column="7"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,0"
                            Background="White">
                        <TextBlock Text="{Binding Points}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111418"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#80000000">
        <Border Background="White"
                CornerRadius="12"
                Padding="24"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TournamentName}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111418"/>
                        <TextBlock Text="{Binding TableTitle}"
                                   FontSize="13"
                                   Foreground="#617589"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseCommand}">
                        <TextBlock Text="×"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Preview body -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Border x:Name="PreviewRoot"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Название турнира по центру для картинки -->
                            <TextBlock Grid.Row="0"
                                       Text="{Binding TournamentName}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#111418"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>

                            <!-- Таблица результатов (использует общий шаблон строки) -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок таблицы (упрощённый, как в основном окне) -->
                                <Border Grid.Row="0"
                                        Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1"
                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <!-- Rk. -->
                                            <ColumnDefinition Width="280"/>
                                            <!-- Команда -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Шахматная таблица (номера команд) -->
                                            <ColumnDefinition Width="60"/>
                                            <!-- В -->
                                            <ColumnDefinition Width="60"/>
                                            <!-- П -->
                                            <ColumnDefinition Width="60"/>
                                            <!-- ВП -->
                                            <ColumnDefinition Width="60"/>
                                            <!-- ПП -->
                                            <ColumnDefinition Width="70"/>
                                            <!-- Очки -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Rk. -->
                                        <Border Grid.Column="0"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                Padding="16,14"
                                                Background="#F9FAFB">
                                            <TextBlock Text="Rk."
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#617589"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Команда -->
                                        <Border Grid.Column="1"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                Padding="16,14"
                                                Background="#F9FAFB">
                                            <TextBlock Text="Команда"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#617589"
                                                       HorizontalAlignment="Left"/>
                                        </Border>

                                        <!-- Номера столбцов шахматной таблицы -->
                                        <ScrollViewer Grid.Column="2"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding HeaderNumbers}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="60"
                                                                Height="70"
                                                                BorderBrush="#E5E7EB"
                                                                BorderThickness="0,0,1,0"
                                                                Background="#F9FAFB">
                                                            <TextBlock Text="{Binding}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#617589"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- В -->
                                        <Border Grid.Column="3"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                Padding="8,14"
                                                Background="#F9FAFB">
                                            <TextBlock Text="В"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#617589"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- П -->
                                        <Border Grid.Column="4"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                Padding="8,14"
                                                Background="#F9FAFB">
                                            <TextBlock Text="П"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#617589"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- ВП -->
                                        <Border Grid.Column="5"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                Padding="8,14"
                                                Background="#F9FAFB">
                                            <TextBlock Text="ВП"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#617589"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- ПП -->
                                        <Border Grid.Column="6"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                Padding="8,14"
                                                Background="#F9FAFB">
                                            <TextBlock Text="ПП"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#617589"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Очки -->
                                        <Border Grid.Column="7"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,0,0"
                                                Padding="8,14"
                                                Background="#F9FAFB">
                                            <TextBlock Text="Очки"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#617589"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Тело таблицы -->
                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding Rows}"
                                              ItemTemplate="{StaticResource ResultsRowTemplate}">
                                </ItemsControl>
                            </Grid>

                            <!-- Легенда внизу предпросмотра -->
                            <Border Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Padding="12"
                                    Background="#F9FAFB"
                                    CornerRadius="8"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Легенда:"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#617589"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Победа (1)" FontSize="11" Foreground="#617589" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#617589" Opacity="0.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ничья (½)" FontSize="11" Foreground="#617589" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#F43F5E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Поражение (0)" FontSize="11" Foreground="#617589" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Экспортируется текущая таблица результатов. Она будет сохранена как изображение (PNG или JPG)."
                               FontSize="12"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,16,0"/>

                    <Button Grid.Column="1"
                            x:Name="CancelButton"
                            Content="Отмена"
                            Padding="20,8"
                            Margin="0,0,0,0"
                            Background="Transparent"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Foreground="#111418"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Command="{Binding CloseCommand}"/>

                    <Button Grid.Column="3"
                            x:Name="SaveButton"
                            Content="Сохранить как изображение"
                            Padding="20,8"
                            Background="#137FEC"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="SaveButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

