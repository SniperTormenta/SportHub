<Window x:Class="SportHubBase.View.MatchCardPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SportHubBase.Converters"
        Title="Предпросмотр карточки матча"
        Height="860" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        FontFamily="Inter, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:SelfCellImageConverter x:Key="SelfCellImageConverter"/>
        <converters:CardBackgroundImageConverter x:Key="CardBackgroundImageConverter"/>
    </Window.Resources>

    <Grid>
        <Border Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="24"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель окна предпросмотра -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Графическая карточка матча"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Border Background="#1E293B" CornerRadius="6" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ВОЛЕЙБОЛ АЛВ" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="34" Height="34"
                            Background="#1E293B"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CloseCommand}">
                        <TextBlock Text="×"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Область карточки, которая рендерится в PNG/JPG -->
                <Viewbox Grid.Row="1" Stretch="Uniform" MaxWidth="1120" MaxHeight="720">
                    <Border x:Name="PreviewRoot"
                            Width="1120"
                            Height="720"
                            Background="#040B1A"
                            ClipToBounds="True">
                        <Grid>
                            <!-- 1. Фоновое изображение (пользовательское или стандартное АЛВ) -->
                            <Image Source="{Binding CardBackgroundData, Converter={StaticResource CardBackgroundImageConverter}}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- 2. Затемняющий спортивный градиент для гарантированной читаемости текста -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#BF040C1E" Offset="0.0"/>
                                        <GradientStop Color="#78061530" Offset="0.45"/>
                                        <GradientStop Color="#99051026" Offset="0.75"/>
                                        <GradientStop Color="#D9030917" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Декоративное мягкое свечение в центре за плашкой счета -->
                            <Ellipse Width="760" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#330284C7" Offset="0.0"/>
                                        <GradientStop Color="#000284C7" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- 3. Основная сетка контента карточки -->
                            <Grid Margin="56,42,56,32">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ВЕРХНИЙ БЛОК: Заголовок турнира и этап/город -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                    <TextBlock Text="М О И   Т У Р Н И Р Ы"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#CBD5E1"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding TournamentName}"
                                               FontSize="44"
                                               FontWeight="Black"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="960"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,12"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding HasStageAndCitySubtitle, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border Width="140" Height="1.5" Background="#8094A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StageAndCitySubtitle}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC"
                                                   Margin="20,0"
                                                   VerticalAlignment="Center"/>
                                        <Border Width="140" Height="1.5" Background="#8094A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ЦЕНТРАЛЬНЫЙ БЛОК: Команды, логотипы, счёт матча и счёт по партиям -->
                                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ЛЕВАЯ КОМАНДА (Баннер + Логотип) -->
                                    <Grid Grid.Column="0" Height="132" VerticalAlignment="Center" Margin="0,0,-12,0">
                                        <!-- Скошенная синяя плашка команды 1 -->
                                        <Border CornerRadius="10,0,0,10"
                                                BorderBrush="#8038BDF8"
                                                BorderThickness="1.5,1.5,0,1.5"
                                                Margin="16,12,0,12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.2">
                                                    <GradientStop Color="#E60369A1" Offset="0.0"/>
                                                    <GradientStop Color="#F20284C7" Offset="0.6"/>
                                                    <GradientStop Color="#E6075985" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid Margin="108,8,28,8">
                                                <TextBlock Text="{Binding Team1Name}"
                                                           FontSize="28"
                                                           FontWeight="ExtraBold"
                                                           Foreground="White"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="84"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Аватарка / Логотип Команды 1 (если не загружена — остаётся пустое место) -->
                                        <Border Width="108" Height="116"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                CornerRadius="14"
                                                Background="#F2071936"
                                                BorderBrush="#38BDF8"
                                                BorderThickness="2"
                                                ClipToBounds="True"
                                                Visibility="{Binding HasTeam1Logo, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Image Source="{Binding Team1LogoUrl, Converter={StaticResource SelfCellImageConverter}}"
                                                   Width="88" Height="96"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>

                                    <!-- ЦЕНТРАЛЬНОЕ ТАБЛО СЧЁТА И ПАРТИЙ -->
                                    <Border Grid.Column="1"
                                            Panel.ZIndex="5"
                                            MinWidth="264"
                                            Background="#F2050E21"
                                            BorderBrush="#8038BDF8"
                                            BorderThickness="2"
                                            CornerRadius="14"
                                            Padding="28,14,28,14"
                                            VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Крупный счёт матча -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Score1Text}"
                                                           FontSize="68"
                                                           FontWeight="Black"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTeam1Winner}" Value="True">
                                                                    <Setter Property="Foreground" Value="#34D399"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text=":"
                                                           FontSize="56"
                                                           FontWeight="Bold"
                                                           Foreground="#94A3B8"
                                                           Margin="18,-8,18,0"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding Score2Text}"
                                                           FontSize="68"
                                                           FontWeight="Black"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTeam2Winner}" Value="True">
                                                                    <Setter Property="Foreground" Value="#34D399"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Результаты отдельных партий (скрываются, если партий нет) -->
                                            <StackPanel Visibility="{Binding HasSetsDetail, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Margin="0,6,0,0">
                                                <Border Height="1" Background="#3338BDF8" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding SetsDetailText}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E2E8F0"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ПРАВАЯ КОМАНДА (Баннер + Логотип) -->
                                    <Grid Grid.Column="2" Height="132" VerticalAlignment="Center" Margin="-12,0,0,0">
                                        <!-- Скошенная синяя плашка команды 2 -->
                                        <Border CornerRadius="0,10,10,0"
                                                BorderBrush="#8038BDF8"
                                                BorderThickness="0,1.5,1.5,1.5"
                                                Margin="0,12,16,12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0">
                                                    <GradientStop Color="#E6075985" Offset="0.0"/>
                                                    <GradientStop Color="#F20284C7" Offset="0.4"/>
                                                    <GradientStop Color="#E60369A1" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid Margin="28,8,108,8">
                                                <TextBlock Text="{Binding Team2Name}"
                                                           FontSize="28"
                                                           FontWeight="ExtraBold"
                                                           Foreground="White"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="84"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Аватарка / Логотип Команды 2 (если не загружена — остаётся пустое место) -->
                                        <Border Width="108" Height="116"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                CornerRadius="14"
                                                Background="#F2071936"
                                                BorderBrush="#38BDF8"
                                                BorderThickness="2"
                                                ClipToBounds="True"
                                                Visibility="{Binding HasTeam2Logo, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Image Source="{Binding Team2LogoUrl, Converter={StaticResource SelfCellImageConverter}}"
                                                   Width="88" Height="96"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- НИЖНЯЯ ИНФОРМАЦИОННАЯ ПЛАШКА (Победитель, Начало игры, Дата, Судья) -->
                                <Border Grid.Row="2"
                                        Background="#D9051024"
                                        BorderBrush="#4038BDF8"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="32,18"
                                        Margin="0,8,0,28"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding HasAnyInfoBlock, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Секция 1: Победитель -->
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding HasWinner, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- Иконка календаря/кубка со звездой как на референсе -->
                                            <Border Width="44" Height="44" CornerRadius="10" Background="#1A38BDF8" BorderBrush="#4D38BDF8" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Path Data="M 8,6 L 24,6 C 25.1,6 26,6.9 26,8 L 26,24 C 26,25.1 25.1,26 24,26 L 8,26 C 6.9,26 6,25.1 6,24 L 6,8 C 6,6.9 6.9,6 8,6 Z M 6,11 L 26,11 M 11,4 L 11,7 M 21,4 L 21,7 M 16,13.5 L 17.6,16.8 L 21.2,17.3 L 18.6,19.8 L 19.2,23.4 L 16,21.7 L 12.8,23.4 L 13.4,19.8 L 10.8,17.3 L 14.4,16.8 Z"
                                                      Stroke="#E2E8F0"
                                                      StrokeThickness="1.6"
                                                      Stretch="Uniform"
                                                      Width="24" Height="24"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Победитель"
                                                           FontSize="15"
                                                           Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding WinnerName}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="260"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Разделитель 1 -->
                                        <Border Grid.Column="1"
                                                Width="1.5"
                                                Background="#26FFFFFF"
                                                Margin="24,2"
                                                Visibility="{Binding ShowDividerAfterWinner, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Секция 2: Начало игры -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding HasStartTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- Иконка часов -->
                                            <Border Width="44" Height="44" CornerRadius="10" Background="#1A38BDF8" BorderBrush="#4D38BDF8" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Path Data="M 16,4 A 12,12 0 1,1 15.99,4 Z M 16,9 L 16,16 L 21,19"
                                                      Stroke="#E2E8F0"
                                                      StrokeThickness="1.8"
                                                      Stretch="Uniform"
                                                      Width="24" Height="24"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Начало игры"
                                                           FontSize="15"
                                                           Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding StartTimeText}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Разделитель 2 -->
                                        <Border Grid.Column="3"
                                                Width="1.5"
                                                Background="#26FFFFFF"
                                                Margin="24,2"
                                                Visibility="{Binding ShowDividerAfterStartTime, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Секция 3: Дата, Судья и MVP -->
                                        <StackPanel Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding HasDetailsColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- Иконка локации/судейства -->
                                            <Border Width="44" Height="44" CornerRadius="10" Background="#1A38BDF8" BorderBrush="#4D38BDF8" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Path Data="M 16,4 C 11.58,4 8,7.58 8,12 C 8,17.5 16,26 16,26 C 16,26 24,17.5 24,12 C 24,7.58 20.42,4 16,4 Z M 16,15 A 3,3 0 1,1 16.01,15 Z"
                                                      Stroke="#E2E8F0"
                                                      StrokeThickness="1.8"
                                                      Stretch="Uniform"
                                                      Width="22" Height="24"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,4"
                                                            Visibility="{Binding HasDate, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Дата"
                                                               FontSize="16"
                                                               Foreground="#94A3B8"
                                                               Width="68"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DateText}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,2"
                                                            Visibility="{Binding HasReferee, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Судья"
                                                               FontSize="16"
                                                               Foreground="#94A3B8"
                                                               Width="68"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RefereeText}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="240"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding HasMvp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="MVP"
                                                               FontSize="15"
                                                               Foreground="#94A3B8"
                                                               Width="68"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MvpText}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="#38BDF8"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="240"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ФИРМЕННАЯ ПОДПИСЬ «ВОЛЕЙБОЛ АЛВ» С ЭМБЛЕМОЙ МЯЧА -->
                                <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="96" Height="1.5" Background="#CCFFFFFF" VerticalAlignment="Center"/>

                                        <!-- Белая эмблема волейбольного мяча -->
                                        <Grid Width="34" Height="34" Margin="16,0">
                                            <Ellipse Stroke="White" StrokeThickness="2" Fill="#1AFFFFFF"/>
                                            <Path Data="M 4,17 Q 17,9 30,17 M 9,5 Q 17,17 9,29 M 25,5 Q 17,17 25,29 M 7,10 Q 17,14 27,10"
                                                  Stroke="White"
                                                  StrokeThickness="1.6"
                                                  Stretch="None"/>
                                        </Grid>

                                        <Border Width="96" Height="1.5" Background="#CCFFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="В О Л Е Й Б О Л   А Л В"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Нижняя панель управления (выбор фона и сохранение PNG/JPG) -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="🖼 Загрузить свой фон"
                            Command="{Binding SelectBackgroundCommand}"
                            Padding="16,10"
                            Background="#1E293B"
                            Foreground="#38BDF8"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                    <Button Grid.Column="1"
                            Content="↺ Стандартный фон АЛВ"
                            Command="{Binding ResetBackgroundCommand}"
                            Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="14,10"
                            Margin="10,0,0,0"
                            Background="#1E293B"
                            Foreground="#CBD5E1"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                    <Button Grid.Column="3"
                            Content="Отмена"
                            Padding="20,10"
                            Background="Transparent"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            Foreground="#E2E8F0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Command="{Binding CloseCommand}"/>

                    <Button Grid.Column="5"
                            Content="💾 Сохранить карточку (PNG / JPG)"
                            Padding="22,10"
                            Background="#0284C7"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="SaveButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
