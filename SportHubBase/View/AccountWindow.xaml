<Window x:Class="SportHubBase.View.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Личный кабинет" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Профиль пользователя" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#1E293B"/>
            <Border Height="2" Background="#E2E8F0" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="16" 
                Padding="25"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Имя пользователя:" 
                               Foreground="#64748B" 
                               FontSize="16" 
                               VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="1" 
                               Text="{Binding Username}" 
                               Foreground="#1E293B" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Другие поля можно добавить здесь -->
            </StackPanel>
        </Border>

        <Button Grid.Row="2" 
                Content="Закрыть" 
                Style="{StaticResource DefaultModernButton}"
                HorizontalAlignment="Right"
                Click="Close_Click"/>
    </Grid>
</Window>
