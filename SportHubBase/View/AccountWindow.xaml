<Window x:Class="SportHubBase.View.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройки аккаунта" Height="800" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7F8"
        FontFamily="Segoe UI, Inter, sans-serif"
        TextElement.Foreground="#0F172A">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#137FEC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F66C2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputFieldStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Настройки аккаунта" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
            <TextBlock Text="Управляйте своим профилем и настройками безопасности." FontSize="14" Foreground="#64748B"/>
        </StackPanel>

        <TabControl Grid.Row="1">

            <TabItem Header="Профиль"  Style="{StaticResource TailwindTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,24,0,0">
                    <StackPanel>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel>
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="100" Height="100" Margin="0,0,24,0">
                                        <Ellipse Width="100" Height="100">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarPath, TargetNullValue='/Resources/avatar.png'}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Button Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                                Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                                Command="{Binding ChangeAvatarCommand}">
                                            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Width="32" Height="32">
                                                <TextBlock Text="📷" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Username}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,12,0"/>
                                            <Border Background="#DBEAFE" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RoleDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Email}" FontSize="15" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="#F1F5F9" Margin="0,0,0,24"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                                        <TextBlock Text="Имя" FontSize="14" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,6"/>
                                        <Border Style="{StaticResource InputFieldStyle}" Background="#F8FAFC">
                                            <TextBox Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     Background="Transparent" BorderThickness="0" Foreground="#0F172A" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                                        <TextBlock Text="Фамилия" FontSize="14" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,6"/>
                                        <Border Style="{StaticResource InputFieldStyle}" Background="#F8FAFC">
                                            <TextBox Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     Background="Transparent" BorderThickness="0" Foreground="#0F172A" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                                        <TextBlock Text="Email" FontSize="14" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,6"/>
                                        <Border Style="{StaticResource InputFieldStyle}" Background="#F8FAFC">
                                            <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     Background="Transparent" BorderThickness="0" Foreground="#0F172A" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                                        <TextBlock Text="Роль" FontSize="14" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,6"/>
                                        <Border Style="{StaticResource InputFieldStyle}" Background="#F1F5F9">
                                            <TextBlock Text="{Binding RoleDisplay}" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Padding="4,0,0,0"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="Номер телефона" FontSize="14" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,6"/>
                                        <Border Style="{StaticResource InputFieldStyle}" Background="#F8FAFC">
                                            <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     Background="Transparent" BorderThickness="0" Foreground="#0F172A" FontSize="14" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Безопасность" Style="{StaticResource TailwindTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,24,0,0">
                    <StackPanel>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Пароль" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                    <TextBlock Text="Используйте уникальный пароль для защиты вашего аккаунта." FontSize="14" Foreground="#64748B" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Сменить пароль" Command="{Binding ChangePasswordCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Width="160"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Опасная зона" FontSize="18" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,0,12"/>
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="Удалить аккаунт" FontSize="16" FontWeight="SemiBold" Foreground="#991B1B" Margin="0,0,0,4"/>
                                    <TextBlock Text="Безвозвратное удаление вашего аккаунта и контента. Это действие нельзя отменить." FontSize="14" Foreground="#DC2626" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Удалить аккаунт" Command="{Binding DeleteAccountCommand}" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center" Width="160"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Сохранить изменения" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="180" Margin="0,0,12,0"/>
            <Button Grid.Column="2" Content="Закрыть" Click="Close_Click" Style="{StaticResource SecondaryButtonStyle}" Width="120"/>
        </Grid>
    </Grid>
</Window>