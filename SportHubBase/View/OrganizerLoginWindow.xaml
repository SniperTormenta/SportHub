<Window x:Class="SportHubBase.View.OrganizerLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в режим организатора"
        Width="440"
        Height="410"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Background="White" Margin="20" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock Text="🔒 Режим организатора"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock x:Name="TournamentTitleText"
                       Text="Турнир"
                       FontSize="13"
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,6,0,20"/>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Логин организатора" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="LoginTextBox"
                         Height="38"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         FontSize="14"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Пароль организатора" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             KeyDown="PasswordBox_KeyDown"/>
            </StackPanel>

            <CheckBox x:Name="RememberMeCheckBox"
                      Content="Запомнить меня на этом ПК для этого турнира"
                      IsChecked="True"
                      FontSize="13"
                      Foreground="#475569"
                      Margin="0,0,0,12"/>

            <TextBlock x:Name="ErrorTextBlock"
                       Foreground="#DC2626"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Отмена"
                        Width="100"
                        Height="38"
                        Margin="0,0,12,0"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="CancelButton_Click"/>
                <Button Content="Войти"
                        Style="{StaticResource DefaultModernButton}"
                        Width="130"
                        Height="38"
                        Click="LoginButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
