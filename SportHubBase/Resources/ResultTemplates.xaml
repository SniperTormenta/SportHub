<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:results="clr-namespace:SportHubBase.Models.Results"
                    xmlns:models="clr-namespace:SportHubBase.Models"
                    xmlns:converters="clr-namespace:SportHubBase.Converters">

    <!-- Заглушки для других форматов -->
    <DataTemplate DataType="{x:Type results:OlympicBracketResultsData}">
        <Grid Margin="40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🏆" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Плей-офф (Сетка)" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111418"/>
                <TextBlock Text="Этот модуль находится в разработке." FontSize="16" Foreground="#617589" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type results:SwissResultsData}">
        <Grid Margin="40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="♟️" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Швейцарская система" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111418"/>
                <TextBlock Text="Этот модуль находится в разработке." FontSize="16" Foreground="#617589" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type results:MultiStageResultsData}">
        <Grid Margin="40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📊" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Многоэтапный турнир" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111418"/>
                <TextBlock Text="Этот модуль находится в разработке." FontSize="16" Foreground="#617589" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Основной шаблон для Круговой системы (Round Robin) -->
    <DataTemplate DataType="{x:Type results:RoundRobinResultsData}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Сообщение о статусе -->
                <RowDefinition Height="*"/>    <!-- Таблица -->
                <RowDefinition Height="Auto"/> <!-- Легенда -->
                <RowDefinition Height="Auto"/> <!-- Кнопка экспорта -->
            </Grid.RowDefinitions>

            <!-- Сообщение о статусе (из базового класса ResultsData) -->
            <TextBlock Grid.Row="0" Text="{Binding StatusMessage}"
                       FontSize="16" Foreground="#617589"
                       Margin="0,0,0,16" TextWrapping="Wrap"
                       HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Шахматная таблица -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Заголовок -->
                        <RowDefinition Height="*"/>    <!-- Тело -->
                    </Grid.RowDefinitions>

                    <!-- Заголовок таблицы -->
                    <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>  <!-- № -->
                                <ColumnDefinition Width="280"/> <!-- Команда -->
                                <ColumnDefinition Width="*"/>   <!-- Ячейки -->
                                <ColumnDefinition Width="60"/>  <!-- В -->
                                <ColumnDefinition Width="60"/>  <!-- П -->
                                <ColumnDefinition Width="60"/>  <!-- ВП -->
                                <ColumnDefinition Width="60"/>  <!-- ПП -->
                                <ColumnDefinition Width="70"/>  <!-- Очки -->
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="16,14">
                                <TextBlock Text="№" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="16,14">
                                <TextBlock Text="Команда" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Left"/>
                            </Border>

                            <!-- Номера столбцов шахматной таблицы -->
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding HeaderNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="60" Height="70" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Background="#F9FAFB">
                                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#617589"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Column="3" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                                <TextBlock Text="В" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Выигранные матчи"/>
                            </Border>

                            <Border Grid.Column="4" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                                <TextBlock Text="П" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Проигранные матчи"/>
                            </Border>

                            <Border Grid.Column="5" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                                <TextBlock Text="ВП" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Выигранные партии/сеты"/>
                            </Border>

                            <Border Grid.Column="6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                                <TextBlock Text="ПП" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Проигранные партии/сеты"/>
                            </Border>

                            <Border Grid.Column="7" Padding="8,14">
                                <TextBlock Text="Очки" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Очки"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Тело таблицы -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ResultRow}">
                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="White" x:Name="RowBorder">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Height="70">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                            <Border Width="32" Height="32" CornerRadius="6" Background="#F3F4F6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Place}" FontSize="14" FontWeight="Bold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>

                                        <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="16,0">
                                            <TextBlock Text="{Binding TeamName}" FontSize="15" FontWeight="SemiBold" Foreground="#111418" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- Ячейки шахматки -->
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:CellResult}">
                                                    <Border Width="60" Height="70" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" 
                                                            Background="{Binding Converter={StaticResource ResultCellBackgroundConverter}}">
                                                        <Grid>
                                                            <Path x:Name="DiagonalLine" Data="M0,0 L60,70 M0,70 L60,0" Stroke="#E5E7EB" StrokeThickness="1" Visibility="Collapsed"/>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{Binding Converter={StaticResource ResultCellColorConverter}}"
                                                                       Text="{Binding DisplayText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                                <Setter Property="Text" Value=""/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Outcome}" Value="NOT_PLAYED">
                                                                                <Setter Property="Text" Value="-"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                            <Setter TargetName="DiagonalLine" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Grid.Column="3" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding Wins}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Column="4" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding Losses}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Column="5" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding SetsWon}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Column="6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding SetsLost}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Column="7">
                                            <TextBlock Text="{Binding Points}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#137FEC"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- Легенда -->
            <Border Grid.Row="2"
                    Margin="0,16,0,16"
                    Padding="16"
                    Background="#F9FAFB"
                    CornerRadius="8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Легенда:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#617589"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Border Width="12" Height="12" CornerRadius="2" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Победа (1)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Border Width="12" Height="12" CornerRadius="2" Background="#617589" Opacity="0.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ничья (½)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="12" Height="12" CornerRadius="2" Background="#F43F5E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Поражение (0)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Кнопка Экспорт (PNG) — снизу слева -->
            <Button Grid.Row="3"
                    Content="Экспорт (PNG)"
                    Command="{Binding DataContext.ExportResultsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource AddTeamButtonStyle}"
                    Padding="16,10"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#3B82F6"
                    Foreground="White"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
