<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:data="clr-namespace:SportHubBase.Services.Results.Data"
                    xmlns:converters="clr-namespace:SportHubBase.Converters" xmlns:View="clr-namespace:SportHubBase.View">

    <!-- Конвертеры для ячеек -->
    <converters:ResultCellBackgroundConverter x:Key="ResultCellBackgroundConverter"/>
    <converters:ResultCellColorConverter x:Key="ResultCellColorConverter"/>
    <converters:SportTypeToHeaderConverter x:Key="SportTypeToHeaderConverter"/>
    <converters:SportTypeToTooltipConverter x:Key="SportTypeToTooltipConverter"/>
    
    <!-- Шаблон для Круговой системы (Round Robin) -->
    <DataTemplate DataType="{x:Type data:RoundRobinResultsData}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок таблицы -->
                <Border Grid.Row="0"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/> <!-- Место -->
                            <ColumnDefinition Width="280"/> <!-- Команда -->
                            <ColumnDefinition Width="*"/> <!-- Шахматная таблица -->
                            <ColumnDefinition Width="60"/> <!-- В -->
                            <ColumnDefinition Width="60"/> <!-- П -->
                            <ColumnDefinition Width="60"/> <!-- ВП -->
                            <ColumnDefinition Width="60"/> <!-- ПП -->
                            <ColumnDefinition Width="70"/> <!-- Очки -->
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="16,14">
                            <TextBlock Text="№" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="16,14">
                            <TextBlock Text="Команда" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Left"/>
                        </Border>
                        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding HeaderNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="57" Height="70" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#617589"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Grid.Column="3" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="В" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Выигранные матчи"/>
                        </Border>
                        <Border Grid.Column="4" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="П" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Проигранные матчи"/>
                        </Border>
                        <Border Grid.Column="5" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="{Binding SportType, Converter={StaticResource SportTypeToHeaderConverter}, ConverterParameter=Won}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" 
                                       ToolTip="{Binding SportType, Converter={StaticResource SportTypeToTooltipConverter}, ConverterParameter=Won}"/>
                        </Border>
                        <Border Grid.Column="6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="{Binding SportType, Converter={StaticResource SportTypeToHeaderConverter}, ConverterParameter=Lost}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" 
                                       ToolTip="{Binding SportType, Converter={StaticResource SportTypeToTooltipConverter}, ConverterParameter=Lost}"/>
                        </Border>
                        <Border Grid.Column="7" Padding="8,14">
                            <TextBlock Text="Очки" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Очки"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Тело таблицы -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}" Margin="0,5,0,-5">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="White">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Техническое поражение">
                                                <Setter Property="Background" Value="#FFF9C4"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Height="70">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <Border Width="32" Height="32" CornerRadius="6" Background="#F3F4F6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Place}" FontSize="14" FontWeight="Bold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding TeamName}" FontSize="15" FontWeight="SemiBold" Foreground="#111418" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0"/>
                                    </Border>
                                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="57" Height="60" Margin="0,0,4,0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Background="{Binding Converter={StaticResource ResultCellBackgroundConverter}}">
                                                        <Grid>
                                                            <Path Data="M0,0 L60,60 M0,60 L60,0" Stroke="#E5E7EB" StrokeThickness="1.5" Stretch="None" Visibility="Collapsed">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{Binding Converter={StaticResource ResultCellColorConverter}}" Text="{Binding DisplayText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                                <Setter Property="Text" Value=""/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Outcome}" Value="NOT_PLAYED">
                                                                                <Setter Property="Text" Value="-"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Border Grid.Column="3" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding Wins}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="4" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding Losses}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="5" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding SetsWon}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding SetsLost}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="7">
                                        <TextBlock Text="{Binding Points}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.Row="2"
                        Margin="0,16,0,16"
                        Padding="16"
                        Background="#F9FAFB"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Легенда:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#617589"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Победа (1)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#617589" Opacity="0.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ничья (½)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#F43F5E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Поражение (0)" FontSize="12" Foreground="#617589" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <!-- Шаблон для Швейцарской системы (турнирная таблица) -->
    <DataTemplate DataType="{x:Type data:SwissResultsData}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/> <!-- Место -->
                            <ColumnDefinition Width="300"/> <!-- Команда -->
                            <ColumnDefinition Width="60"/> <!-- Игры -->
                            <ColumnDefinition Width="60"/> <!-- В -->
                            <ColumnDefinition Width="60"/> <!-- Н -->
                            <ColumnDefinition Width="60"/> <!-- П -->
                            <ColumnDefinition Width="60"/> <!-- BYE -->
                            <ColumnDefinition Width="100"/> <!-- Buchholz -->
                            <ColumnDefinition Width="80"/> <!-- Очки -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="16,14">
                            <TextBlock Text="№" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="16,14">
                            <TextBlock Text="Команда" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Left"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="И" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Сыграно матчей"/>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="В" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Победы"/>
                        </Border>
                        <Border Grid.Column="4" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="Н" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Ничьи"/>
                        </Border>
                        <Border Grid.Column="5" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="П" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Поражения"/>
                        </Border>
                        <Border Grid.Column="6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="Б" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Пропуск тура (BYE)"/>
                        </Border>
                        <Border Grid.Column="7" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="КБ" FontSize="11" FontWeight="SemiBold" Foreground="#617589" HorizontalAlignment="Center" ToolTip="Коэффициент Бухгольца (-1)"/>
                        </Border>
                        <Border Grid.Column="8" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,14">
                            <TextBlock Text="Очки" FontSize="11" FontWeight="Bold" Foreground="#111418" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="9" Padding="8,14"/>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}" Margin="0,0,0,-1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="White">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Height="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <Border Width="32" Height="32" CornerRadius="6" Background="#F3F4F6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Place}" FontSize="14" FontWeight="Bold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding TeamName}" FontSize="15" FontWeight="SemiBold" Foreground="#111418" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0"/>
                                    </Border>
                                    <Border Grid.Column="2" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding MatchesPlayed}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="3" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding Wins}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="4" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding Draws}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="5" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding Losses}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding Byes}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="7" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding BuchholzCut1}" FontSize="14" FontWeight="SemiBold" Foreground="#111418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="8" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding Points}" FontSize="14" FontWeight="Bold" Foreground="#137FEC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="9"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <!-- Шаблон для Олимпийской системы (реальная сетка) -->
    <DataTemplate DataType="{x:Type data:OlympicBracketResultsData}">
        <View:TournamentBracketControl />
    </DataTemplate>

    <!-- Шаблон для Многоэтапной системы (заглушка) -->
    <DataTemplate DataType="{x:Type data:MultiStageResultsData}">
        <Grid Background="White" Margin="20">
            <TextBlock Text="Многоэтапная система (Группы + Плей-офф) - в разработке" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       FontSize="20" Foreground="#9CA3AF"/>
        </Grid>
    </DataTemplate>
    
</ResourceDictionary>
